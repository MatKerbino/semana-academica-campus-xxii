---
import { btnPrimario, btnTexto } from "../../lib/inscricao/estilos";
import { url } from "../../lib/url";
import Alerta from "../Alerta.astro";
---

<!-- Inscrição confirmada -->
<div id="confirmada" hidden class="mx-auto flex w-full max-w-[488px] flex-col items-center gap-4 rounded-cartao border border-borda bg-white p-6 text-center shadow-[0_1px_3px_rgba(15,41,8,0.08)] sm:p-9">
  <div class="flex size-[72px] items-center justify-center rounded-full bg-verde-claro text-verde-escuro"><span data-ico="circulo-ok" data-grande></span></div>
  <h2 class="text-[32px] leading-[1.3] font-bold text-verde-escuro">Inscrição confirmada!</h2>
  <p id="confirmada-texto" class="text-[15px] leading-normal text-chumbo"></p>
  <Alerta tipo="aviso" titulo="Confirme seu e-mail" class="w-full text-left"><span id="confirmada-email"></span></Alerta>
  <Alerta tipo="info" titulo="Próximo passo" class="w-full text-left"><span id="confirmada-proximo"></span></Alerta>
  <p id="reenvio-status" role="status" hidden class="text-[13px] text-verde-medio"></p>
  <a href={url("/minha-inscricao")} class={`${btnPrimario} w-full`}><span data-ico="lista"></span>Ver minha inscrição</a>
  <button type="button" id="reenviar" class={btnTexto}><span data-ico="email"></span>Reenviar e-mail de verificação</button>
</div>
