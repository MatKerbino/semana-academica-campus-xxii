---
interface Props {
  nome: string;
  rotulo: string;
  tipo?: string;
  autocomplete?: string;
  ajuda?: string;
  inputmode?: "numeric" | "tel" | "email" | "text";
  maxlength?: number;
  minlength?: number;
  obrigatorio?: boolean;
  opcoes?: { valor: string; rotulo: string }[];
}
const { nome, rotulo, tipo = "text", autocomplete, ajuda, inputmode, maxlength, minlength, obrigatorio = true, opcoes } = Astro.props;
const id = `campo-${nome}`;
const estilo =
  "mt-1 w-full rounded-lg border border-borda bg-white px-3 py-2 text-sm text-chumbo aria-[invalid=true]:border-red-600";
---

<div>
  <label for={id} class="block text-sm font-semibold text-verde-escuro">{rotulo}</label>
  {
    opcoes ? (
      <select id={id} name={nome} required={obrigatorio} aria-describedby={`${id}-erro`} class={estilo}>
        <option value="">Selecione…</option>
        {opcoes.map((o) => <option value={o.valor}>{o.rotulo}</option>)}
      </select>
    ) : (
      <input
        id={id}
        name={nome}
        type={tipo}
        required={obrigatorio}
        autocomplete={autocomplete}
        inputmode={inputmode}
        maxlength={maxlength}
        minlength={minlength}
        aria-describedby={`${id}-erro${ajuda ? ` ${id}-ajuda` : ""}`}
        class={estilo}
      />
    )
  }
  {ajuda && <p id={`${id}-ajuda`} class="mt-0.5 text-xs text-chumbo/70">{ajuda}</p>}
  <p id={`${id}-erro`} data-erro={nome} class="mt-0.5 text-xs font-semibold text-red-700"></p>
</div>
