---
import { CalendarDays, Eye, EyeOff, IdCard, Lock, Mail, Phone, TriangleAlert, User } from "@lucide/astro";

interface Props {
  nome: string;
  rotulo: string;
  tipo?: string;
  icone?: "usuario" | "cadeado" | "email" | "telefone" | "data" | "cpf";
  placeholder?: string;
  autocomplete?: string;
  ajuda?: string;
  inputmode?: "numeric" | "tel" | "email" | "text";
  maxlength?: number;
  minlength?: number;
  obrigatorio?: boolean;
  opcoes?: { valor: string; rotulo: string }[];
  valor?: string;
}
const { nome, rotulo, tipo = "text", icone, placeholder, autocomplete, ajuda, inputmode, maxlength, minlength, obrigatorio = true, opcoes, valor } = Astro.props;
const id = `campo-${nome}`;
const senha = tipo === "password";
const icones = { usuario: User, cadeado: Lock, email: Mail, telefone: Phone, data: CalendarDays, cpf: IdCard };
const Icone = icone ? icones[icone] : null;
---

<div class="flex flex-col gap-1.5">
  <label for={id} class="text-sm leading-[1.4] font-semibold text-chumbo">{rotulo}</label>
  <div
    class="group flex h-12 items-center gap-2.5 rounded-campo border-[1.5px] border-borda bg-white px-3.5 focus-within:border-azul has-[[aria-invalid=true]]:border-2 has-[[aria-invalid=true]]:border-erro"
  >
    {Icone && <Icone class="size-5 shrink-0 text-chumbo group-has-[[aria-invalid=true]]:text-erro" aria-hidden="true" />}
    {
      opcoes ? (
        <select id={id} name={nome} required={obrigatorio} aria-describedby={`${id}-erro`} class="min-w-0 flex-1 bg-transparent text-[15px] text-chumbo outline-none">
          <option value="">Selecione…</option>
          {opcoes.map((o) => <option value={o.valor} selected={o.valor === valor}>{o.rotulo}</option>)}
        </select>
      ) : (
        <input
          id={id}
          name={nome}
          type={tipo}
          value={valor}
          required={obrigatorio}
          placeholder={placeholder}
          autocomplete={autocomplete}
          inputmode={inputmode}
          maxlength={maxlength}
          minlength={minlength}
          aria-describedby={`${id}-erro${ajuda ? ` ${id}-ajuda` : ""}`}
          class="min-w-0 flex-1 bg-transparent text-[15px] text-chumbo outline-none placeholder:text-texto-suave"
        />
      )
    }
    {
      senha && (
        <button type="button" data-mostrar-senha aria-label="Mostrar senha" aria-pressed="false" class="shrink-0 cursor-pointer text-chumbo">
          <EyeOff class="size-[18px]" data-olho-fechado aria-hidden="true" />
          <Eye class="hidden size-[18px]" data-olho-aberto aria-hidden="true" />
        </button>
      )
    }
    <TriangleAlert class="hidden size-[18px] shrink-0 text-erro group-has-[[aria-invalid=true]]:block" aria-hidden="true" />
  </div>
  {ajuda && <p id={`${id}-ajuda`} class="text-[13px] leading-normal text-texto-suave">{ajuda}</p>}
  <p id={`${id}-erro`} data-erro={nome} class="text-[13px] leading-normal text-erro empty:hidden"></p>
</div>

<script>
  document.addEventListener("click", (e) => {
    const botao = (e.target as HTMLElement).closest<HTMLButtonElement>("[data-mostrar-senha]");
    if (!botao) return;
    const entrada = botao.parentElement!.querySelector("input")!;
    const mostrar = entrada.type === "password";
    entrada.type = mostrar ? "text" : "password";
    botao.setAttribute("aria-pressed", String(mostrar));
    botao.setAttribute("aria-label", mostrar ? "Ocultar senha" : "Mostrar senha");
    botao.querySelector("[data-olho-fechado]")!.classList.toggle("hidden", mostrar);
    botao.querySelector("[data-olho-aberto]")!.classList.toggle("hidden", !mostrar);
  });
</script>
