---
import { url } from "../lib/url";
import { Award, ArrowRight, FileText, GraduationCap, Image, Presentation, Users } from "@lucide/astro";
import { dias, palestrantePor, type Atividade, type TipoAtividade } from "../data/evento";

interface Props {
  atividade: Atividade;
}
const { atividade } = Astro.props;

const icones: Record<TipoAtividade, typeof Users> = {
  minicurso: GraduationCap,
  curso: GraduationCap,
  palestra: Presentation,
  "mesa-redonda": Users,
  banner: Image,
  artigo: FileText,
  cerimonia: Award,
  organizacao: Users,
};

const Icone = icones[atividade.tipo];
const dia = dias.find((d) => d.id === atividade.dia)!;
const diaCurto = dia.rotulo.split(" · ")[0];
const palestrante = palestrantePor(atividade.palestrante);
/* Nas listagens o tipo já vem do ícone e da aba, então o prefixo do título é redundante. */
const titulo = atividade.titulo.replace(/^(Minicurso|Palestra|Curso|Mesa-redonda|Artigos?):\s*/, "");
const chips = [
  `${diaCurto} · ${atividade.horario.replace(" às ", "–").replace(/\s*\(.*\)/, "")}`,
  atividade.cargaHoraria,
  atividade.vagas?.replace("participantes", "vagas"),
].filter(Boolean) as string[];
---

<article class="flex flex-col gap-1 rounded-cartao border border-verde-medio bg-palha p-3">
  <Icone class="size-6 text-verde-escuro" aria-hidden="true" />

  <div class="flex flex-wrap gap-2">
    {
      chips.map((chip) => (
        <span class="rounded-full bg-creme px-2.5 py-0.5 text-xs font-bold text-verde-escuro">{chip}</span>
      ))
    }
  </div>

  <h3 class="text-[17px] leading-tight font-semibold text-verde-escuro">
    <a href={url(`/atividades/${atividade.slug}`)} class="hover:underline">{titulo}</a>
  </h3>

  <p class="line-clamp-1 text-sm text-chumbo">{atividade.descricao[0]}</p>

  <div class="mt-auto flex flex-wrap items-baseline justify-between gap-x-3 pt-1">
    <p class="text-tabela text-chumbo/80">
      {atividade.local}{palestrante && ` · ${palestrante.nome}`}
    </p>
    <a
      href={url(`/atividades/${atividade.slug}`)}
      class="flex items-center gap-1 text-tabela font-semibold text-azul hover:underline"
    >
      Ver página da atividade
      <ArrowRight class="size-3.5" aria-hidden="true" />
    </a>
  </div>
</article>
