---
import { FileText, GraduationCap, Image, MicVocal, Presentation } from "@lucide/astro";
import { tagsTipo, type TipoAtividade } from "../data/evento";

interface Props { tipo: TipoAtividade }
const tag = tagsTipo[Astro.props.tipo];
const icones = { mic: MicVocal, apresentacao: Presentation, capelo: GraduationCap, imagem: Image, arquivo: FileText };
const Icone = tag ? icones[tag.icone] : null;
---

{
  tag && Icone && (
    <span class:list={["flex items-center gap-1.5 text-xs leading-[1.3] font-bold tracking-[0.4px] uppercase", tag.cor]}>
      <Icone class="size-3.5" aria-hidden="true" />
      {tag.rotulo}
    </span>
  )
}
