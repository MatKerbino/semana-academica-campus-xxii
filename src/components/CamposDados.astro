---
import { Briefcase, GraduationCap, Presentation, User } from "@lucide/astro";
import Campo from "./Campo.astro";

interface Props {
  /** Texto de apoio sob o perfil. */
  ajudaPerfil?: string;
}
const { ajudaPerfil = "Professor(a) e Profissional são categorias diferentes. Escolha a que melhor descreve você." } = Astro.props;
const perfis = [
  { valor: "estudante", rotulo: "Estudante", Icone: GraduationCap },
  { valor: "professor", rotulo: "Professor(a)", Icone: Presentation },
  { valor: "profissional", rotulo: "Profissional", Icone: Briefcase },
  { valor: "outro", rotulo: "Outro", Icone: User },
];
---

<div class="flex flex-col gap-4">
        <div class="grid gap-4 md:grid-cols-2">
          <Campo nome="nome" rotulo="Nome completo *" icone="usuario" placeholder="Seu nome completo" autocomplete="name" />
          <Campo nome="cpf" rotulo="CPF *" icone="cpf" placeholder="000.000.000-00" inputmode="numeric" maxlength={14} />
          <Campo nome="email" rotulo="E-mail *" icone="email" placeholder="nome@exemplo.com" tipo="email" autocomplete="email" />
          <Campo nome="telefone" rotulo="Telefone *" icone="telefone" placeholder="(00) 00000-0000" inputmode="tel" maxlength={15} autocomplete="tel" />
          <Campo nome="dataNascimento" rotulo="Data de nascimento *" icone="data" placeholder="dd/mm/aaaa" inputmode="numeric" maxlength={10} autocomplete="bday" />
        </div>
        <fieldset class="flex flex-col gap-1.5">
          <legend class="mb-1.5 text-sm leading-[1.4] font-semibold text-chumbo">Perfil *</legend>
          <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
            {
              perfis.map(({ valor, rotulo, Icone }) => (
                <label class="flex cursor-pointer items-center gap-3 rounded-campo border-[1.5px] border-borda bg-white px-4 py-3.5 text-lg leading-[1.3] font-semibold text-chumbo has-[:checked]:border-2 has-[:checked]:border-verde-medio has-[:checked]:bg-verde-claro has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-azul">
                  <input type="radio" name="perfil" value={valor} class="size-[18px] shrink-0 cursor-pointer appearance-none rounded-full border-[1.5px] border-chumbo/60 bg-white checked:border-[5px] checked:border-verde-medio" />
                  <Icone class="size-5 shrink-0 text-chumbo" aria-hidden="true" />
                  {rotulo}
                </label>
              ))
            }
          </div>
          <p class="text-[13px] leading-normal text-texto-suave" id="ajuda-perfil">{ajudaPerfil}</p>
          <p data-erro="perfil" class="text-[13px] leading-normal text-erro empty:hidden"></p>
        </fieldset>
</div>
