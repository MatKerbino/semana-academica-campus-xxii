---
import { url } from "../lib/url";
import { Download, Info } from "@lucide/astro";
import Abas from "./Abas.astro";
import CartaoAtividade from "./CartaoAtividade.astro";
import PaginaCabecalho from "./PaginaCabecalho.astro";
import Base from "../layouts/Base.astro";
import type { Atividade } from "../data/evento";

interface Props {
  titulo: string;
  descricao: string;
  ativo: string;
  /** Uma aba por grupo de atividades, para o conteúdo caber na tela sem rolagem. */
  grupos: { id: string; rotulo: string; atividades: Atividade[] }[];
  notasRotulo: string;
  notas: string[];
  cta?: { rotulo: string; href: string };
}
const { titulo, descricao, ativo, grupos, notasRotulo, notas, cta } = Astro.props;
---

<Base titulo={titulo} descricao={descricao} ativo={ativo}>
  <PaginaCabecalho titulo={titulo} descricao={descricao} trilha={[{ href: "/", rotulo: "Início" }]} />

  <Abas
    rotuloLista={titulo}
    abas={[...grupos.map((g) => ({ id: g.id, rotulo: g.rotulo })), { id: "notas", rotulo: notasRotulo }]}
  >
    {
      grupos.map((grupo) => (
        <div data-painel={grupo.id} class="grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
          {grupo.atividades.map((atividade) => (
            <CartaoAtividade atividade={atividade} />
          ))}
        </div>
      ))
    }

    <div data-painel="notas" class="rounded-cartao bg-creme p-6">
      <h2 class="flex items-center gap-2 text-xl font-semibold text-verde-escuro">
        <Info class="size-5 text-verde-medio" aria-hidden="true" />
        {notasRotulo}
      </h2>
      <ul class="mt-3 space-y-2">
        {
          notas.map((nota) => (
            <li class="flex gap-2 text-sm text-chumbo">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-verde-medio" aria-hidden="true" />
              {nota}
            </li>
          ))
        }
      </ul>
      {
        cta && (
          <a
            href={url(cta.href)}
            target="_blank"
            rel="noopener"
            class="mt-5 inline-flex items-center gap-2 rounded-full bg-verde-cta px-7 py-[15px] text-[15px] font-semibold text-verde-noite shadow"
          >
            <Download class="size-4" aria-hidden="true" />
            {cta.rotulo}
          </a>
        )
      }
    </div>
  </Abas>
</Base>
