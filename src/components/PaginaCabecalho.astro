---
import { url } from "../lib/url";
import Ornamento from "./Ornamento.astro";

interface Props {
  titulo: string;
  descricao?: string;
  trilha?: { href: string; rotulo: string }[];
  /** "simples": trilha + título sobre o fundo da página, sem a faixa creme (Cronograma e Atividades). */
  simples?: boolean;
}
const { titulo, descricao, trilha = [{ href: "/", rotulo: "Início" }], simples = false } = Astro.props;
---

{
  simples ? (
    <div class="flex flex-col gap-1.5">
      <nav aria-label="Trilha de navegação" class="flex gap-2 text-sm leading-[1.4]">
        {trilha.map((item) => (
          <>
            <a href={url(item.href)} class="font-semibold text-verde-medio hover:underline">{item.rotulo}</a>
            <span class="text-[13px] text-texto-suave">/</span>
          </>
        ))}
        <span class="text-[13px] text-texto-suave">{titulo}</span>
      </nav>
      <h1 class="text-[32px] leading-[1.3] font-bold text-verde-escuro">{titulo}</h1>
      {descricao && <p class="text-[15px] text-chumbo">{descricao}</p>}
      <slot />
    </div>
  ) : (
    <div class="relative mb-3 overflow-hidden rounded-cartao bg-creme px-8 py-4">
      <Ornamento />
      <div class="relative">
        <nav aria-label="Trilha de navegação" class="text-[13px] leading-normal font-semibold">
          {trilha.map((item) => (
            <>
              <a href={url(item.href)} class="text-verde-medio hover:underline">{item.rotulo}</a>
              <span class="mx-1.5 text-verde-medio/60">/</span>
            </>
          ))}
          <span class="text-verde-escuro/70">{titulo}</span>
        </nav>
        <h1 class="pt-1 text-secao leading-[1.5] font-bold text-verde-escuro">{titulo}</h1>
        {descricao && <p class="mt-1.5 max-w-[1000px] text-sm text-chumbo">{descricao}</p>}
        <slot />
      </div>
    </div>
  )
}
