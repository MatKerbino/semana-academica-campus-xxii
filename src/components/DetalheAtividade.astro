---
import { url } from "../lib/url";
import { Calendar, Clock, GraduationCap, Info, MapPin, User, UserPlus, Users } from "@lucide/astro";
import TagTipo from "./TagTipo.astro";
import { dias, palestrantePor, type Atividade } from "../data/evento";

interface Props { atividade: Atividade }
const { atividade: a } = Astro.props;
const dia = dias.find((d) => d.id === a.dia)!;
const palestrante = palestrantePor(a.palestrante);

const linhas = [
  { icone: Calendar, rotulo: "Data", valor: dia.data },
  { icone: Clock, rotulo: "Horário", valor: a.horario },
  { icone: MapPin, rotulo: "Local", valor: a.local },
  palestrante && { icone: User, rotulo: "Responsável", valor: palestrante.nome },
  a.vagas && { icone: Users, rotulo: "Vagas", valor: a.vagas },
  a.cargaHoraria && { icone: GraduationCap, rotulo: "Carga horária", valor: a.cargaHoraria },
].filter(Boolean) as { icone: typeof Calendar; rotulo: string; valor: string }[];
---

<article class="flex flex-col gap-4 rounded-cartao border-2 border-verde-medio bg-white p-5 shadow-[0_1px_3px_rgba(15,41,8,0.08)] lg:p-7">
  <div class="flex flex-wrap items-center gap-2.5">
    <TagTipo tipo={a.tipo} />
    <span class="text-xs leading-[1.3] font-bold tracking-[0.4px] text-verde-escuro uppercase">Atividade selecionada</span>
  </div>
  <h2 class="text-2xl leading-[1.3] font-bold text-verde-escuro">{a.titulo}</h2>
  <dl class="flex flex-col gap-2.5 rounded-campo bg-palha p-4">
    {
      linhas.map((l) => (
        <div class="flex items-start gap-2.5">
          <l.icone class="mt-0.5 size-4 shrink-0 text-verde-medio" aria-hidden="true" />
          <div class="leading-normal">
            <dt class="text-[13px] text-texto-suave">{l.rotulo}</dt>
            <dd class="text-[15px] text-chumbo">{l.valor}</dd>
          </div>
        </div>
      ))
    }
  </dl>
  <h3 class="text-sm leading-[1.4] font-semibold text-chumbo">Descrição</h3>
  <div class="space-y-4 text-[15px] leading-normal text-chumbo">
    {a.descricao.map((p) => <p>{p}</p>)}
  </div>
  {
    a.topicos && (
      <>
        <h3 class="text-sm leading-[1.4] font-semibold text-chumbo">Tópicos</h3>
        <ul class="space-y-2 text-[15px] leading-normal text-chumbo">
          {a.topicos.map((t) => <li class="flex gap-2"><span aria-hidden="true">•</span>{t}</li>)}
        </ul>
      </>
    )
  }
  <div class="flex flex-wrap items-center gap-3">
    <a
      href={url("/inscricao")}
      class="flex items-center gap-2 rounded-full bg-verde-cta px-[22px] py-3 text-[15px] leading-[1.3] font-bold text-verde-noite hover:brightness-95"
    >
      <UserPlus class="size-[18px]" aria-hidden="true" />
      Inscrever-se
    </a>
    {
      palestrante && (
        <a href={url("/palestrantes")} class="flex items-center gap-2 px-2 py-3 text-[15px] leading-[1.3] font-bold text-verde-medio hover:underline">
          <User class="size-[18px]" aria-hidden="true" />
          Ver responsável
        </a>
      )
    }
  </div>
  <p class="flex items-center gap-2 text-[13px] leading-normal text-texto-suave">
    <Info class="size-4 shrink-0" aria-hidden="true" />
    A consulta das atividades não exige cadastro, login ou inscrição.
  </p>
</article>
