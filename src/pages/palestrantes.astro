---
import { url } from "../lib/url";
import { ExternalLink, Mail } from "@lucide/astro";
import Abas from "../components/Abas.astro";
import PaginaCabecalho from "../components/PaginaCabecalho.astro";
import Base from "../layouts/Base.astro";
import { atividades, palestrantes, type AreaTematica } from "../data/evento";

const areas: AreaTematica[] = ["Educação", "Saúde", "Tecnologia", "Meio Ambiente"];
const colunas = (n: number) =>
  n <= 2 ? "sm:grid-cols-2" : n === 3 ? "sm:grid-cols-2 lg:grid-cols-3" : "sm:grid-cols-2 lg:grid-cols-4";

const iniciais = (nome: string) => {
  /* Ignora títulos (Dra., Me., Esp.) e usa a inicial do primeiro e do último nome. */
  const partes = nome.split(" ").filter((n) => !n.endsWith("."));
  return partes[0][0] + partes[partes.length - 1][0];
};
---

<Base titulo="Palestrantes e Ministrantes" ativo="/palestrantes">
  <PaginaCabecalho
    titulo="Palestrantes e Ministrantes"
    descricao="Profissionais e pesquisadores responsáveis pelas palestras, minicursos e cursos da Semana Acadêmica."
    trilha={[{ href: "/", rotulo: "Início" }]}
  />

  <Abas rotuloLista="Áreas temáticas" abas={areas.map((area) => ({ id: area, rotulo: area }))}>
    {
      areas.map((area) => {
        const doArea = palestrantes.filter((p) => p.area === area);
        return (
          <div data-painel={area} class:list={["grid gap-3", colunas(doArea.length)]}>
            {doArea.map((palestrante) => {
              const suas = atividades.filter((a) => a.palestrante === palestrante.slug);
              return (
                <article class="flex flex-col gap-1.5 rounded-cartao border border-verde-medio bg-palha p-4">
                  <span
                    class="flex size-11 items-center justify-center rounded-full bg-verde-medio text-sm font-bold text-white"
                    aria-hidden="true"
                  >
                    {iniciais(palestrante.nome)}
                  </span>
                  <h2 class="text-base leading-tight font-bold text-verde-escuro">{palestrante.nome}</h2>
                  <p class="text-tabela text-chumbo">{palestrante.titulacao}</p>
                  <p class="text-tabela text-chumbo/75">{palestrante.instituicao}</p>

                  {suas.length > 0 && (
                    <p class="text-tabela text-chumbo/80">
                      {suas.map((a, i) => (
                        <>
                          {i > 0 && <span class="text-chumbo/40">, </span>}
                          <a href={url(`/atividades/${a.slug}`)} class="text-azul hover:underline">
                            {a.titulo.replace(/^(Minicurso|Palestra|Curso|Mesa-redonda|Artigos?):\s*/, "")}
                          </a>
                        </>
                      ))}
                    </p>
                  )}

                  <div class="mt-auto pt-1 text-tabela font-semibold">
                    <a
                      href={`mailto:${palestrante.email}`}
                      class="flex items-center gap-1.5 text-azul hover:underline"
                    >
                      <Mail class="size-3.5 shrink-0" aria-hidden="true" />
                      {palestrante.email}
                    </a>
                    <a
                      href={palestrante.lattes}
                      target="_blank"
                      rel="noopener"
                      class="mt-0.5 flex items-center gap-1.5 text-azul hover:underline"
                    >
                      <ExternalLink class="size-3.5 shrink-0" aria-hidden="true" />
                      Currículo Lattes
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        );
      })
    }
  </Abas>

  <p class="mt-3 rounded-cartao bg-creme px-4 py-3 text-tabela text-chumbo">
    Os links de Currículo Lattes e as informações de contato são exibidos apenas quando autorizados e disponibilizados
    pelo palestrante.
  </p>
</Base>
