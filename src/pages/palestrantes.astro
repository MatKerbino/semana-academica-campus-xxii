---
import { url } from "../lib/url";
import { ExternalLink, Mail } from "@lucide/astro";
import Abas from "../components/Abas.astro";
import PaginaCabecalho from "../components/PaginaCabecalho.astro";
import Base from "../layouts/Base.astro";
import { atividadesDe, gruposPalestrantes, linkAtividade, palestrantesDoGrupo } from "../data/evento";

/* Grupos derivados das atividades que cada pessoa ministra (dados do Even3); só aparecem os que têm gente. */
const grupos = gruposPalestrantes
  .map((g) => ({ ...g, pessoas: palestrantesDoGrupo(g.tipos) }))
  .filter((g) => g.pessoas.length > 0);

const colunas = "sm:grid-cols-2 lg:grid-cols-3";

const iniciais = (nome: string) => {
  /* Ignora títulos (Dra., Me., Esp.), siglas depois de hífen e usa a inicial do primeiro e do último nome. */
  const partes = nome.split(" - ")[0].split(" ").filter((n) => n && !n.endsWith("."));
  return (partes[0]?.[0] ?? "") + (partes.length > 1 ? partes[partes.length - 1][0] : "");
};
const semPrefixo = (t: string) => t.replace(/^(Minicurso|Oficina|Curso|Mesa-redonda \d+):\s*/, "");
---

<Base titulo="Palestrantes e Ministrantes" ativo="/palestrantes">
  <PaginaCabecalho
    titulo="Palestrantes e Ministrantes"
    descricao="Profissionais e pesquisadores responsáveis pelas mesas-redondas, minicursos, oficinas e cursos da Semana Acadêmica."
    trilha={[{ href: "/", rotulo: "Início" }]}
  />

  <Abas rotuloLista="Atividades ministradas" abas={grupos.map((g) => ({ id: g.id, rotulo: g.rotulo }))}>
    {
      grupos.map((g) => (
        <div data-painel={g.id} class:list={["grid gap-3", colunas]}>
          {g.pessoas.map((palestrante) => {
            const suas = atividadesDe(palestrante.slug);
            return (
              <article class="flex flex-col gap-1.5 rounded-cartao border border-verde-medio bg-palha p-4">
                <span
                  class="flex size-11 items-center justify-center rounded-full bg-verde-medio text-sm font-bold text-white"
                  aria-hidden="true"
                >
                  {iniciais(palestrante.nome)}
                </span>
                <h2 class="text-base leading-tight font-bold text-verde-escuro">{palestrante.nome}</h2>
                {palestrante.cargo && <p class="text-tabela text-chumbo">{palestrante.cargo}</p>}

                {palestrante.bio && (
                  <details class="text-tabela text-chumbo/80">
                    <summary class="cursor-pointer font-semibold text-verde-medio">Currículo resumido</summary>
                    <p class="mt-1">{palestrante.bio}</p>
                  </details>
                )}

                {suas.length > 0 && (
                  <p class="text-tabela text-chumbo/80">
                    {suas.map((a, i) => (
                      <>
                        {i > 0 && <span class="text-chumbo/40">, </span>}
                        <a href={url(linkAtividade(a.slug))} class="text-azul hover:underline">
                          {semPrefixo(a.titulo)}
                        </a>
                      </>
                    ))}
                  </p>
                )}

                {(palestrante.email || palestrante.lattes) && (
                  <div class="mt-auto pt-1 text-tabela font-semibold">
                    {palestrante.email && (
                      <a href={`mailto:${palestrante.email}`} class="flex items-center gap-1.5 break-all text-azul hover:underline">
                        <Mail class="size-3.5 shrink-0" aria-hidden="true" />
                        {palestrante.email}
                      </a>
                    )}
                    {palestrante.lattes && (
                      <a
                        href={palestrante.lattes}
                        target="_blank"
                        rel="noopener"
                        class="mt-0.5 flex items-center gap-1.5 text-azul hover:underline"
                      >
                        <ExternalLink class="size-3.5 shrink-0" aria-hidden="true" />
                        Currículo Lattes
                      </a>
                    )}
                  </div>
                )}
              </article>
            );
          })}
        </div>
      ))
    }
  </Abas>
</Base>
