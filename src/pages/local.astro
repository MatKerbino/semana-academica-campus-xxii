---
import { ExternalLink } from "@lucide/astro";
import PaginaCabecalho from "../components/PaginaCabecalho.astro";
import Base from "../layouts/Base.astro";
---

<Base titulo="Local do evento" ativo="/local">
  <PaginaCabecalho
    titulo="Local do evento"
    descricao="Onde acontecem as atividades do evento, com endereço e mapa."
    trilha={[{ href: "/", rotulo: "Início" }]}
  />

  <div class="grid gap-4 lg:grid-cols-[1.4fr_1fr]">
    <!-- Mapa incorporado (OpenStreetMap, sem chave de API); o botão ao lado abre o Google Maps (RF-04). -->
    <figure>
      <iframe id="mapa" title="Mapa do local" loading="lazy" class="h-[250px] w-full rounded-cartao border border-borda"></iframe>
      <figcaption class="mt-1.5 text-tabela text-chumbo/70">
        Mapa de referência · a localização exata abre no Google Maps.
      </figcaption>
    </figure>

    <aside class="h-fit rounded-cartao border border-verde-medio bg-palha p-4">
      <h2 class="text-base font-bold text-verde-escuro">Endereço</h2>
      <ul id="endereco" class="mt-2 space-y-2"></ul>
      <a
        data-link="maps"
        href="#"
        class="mt-3 flex items-center justify-center gap-2 rounded-full bg-azul px-5 py-2.5 text-[15px] font-semibold text-white hover:opacity-90"
      >
        <ExternalLink class="size-4" aria-hidden="true" />
        Abrir no Google Maps
      </a>
    </aside>
  </div>
</Base>

<script>
  import { iniciar } from "../lib/paginas/local";
  iniciar();
</script>
