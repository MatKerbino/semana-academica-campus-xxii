---
import { ArrowLeft, Ban } from "@lucide/astro";
import Base from "../../layouts/Base.astro";
import { url } from "../../lib/url";

const botao = "flex w-full items-center justify-center gap-2 rounded-full bg-verde-cta px-[22px] py-3 text-[15px] leading-[1.3] font-bold text-verde-noite hover:brightness-95";
---

<Base titulo="Acesso restrito" espaco="acesso">
  <div class="mx-auto flex w-full max-w-[532px] flex-col items-center gap-4 rounded-cartao border border-borda bg-white p-6 shadow-[0_1px_3px_rgba(15,41,8,0.08)] sm:p-9">
    <div class="flex size-16 items-center justify-center rounded-full bg-erro-fundo text-erro">
      <Ban class="size-8" aria-hidden="true" />
    </div>
    <h1 class="text-center text-2xl leading-[1.3] font-bold text-verde-escuro">Acesso restrito a administradores</h1>
    <p class="text-center text-[15px] leading-normal text-chumbo">
      A conta <span id="login"></span> não tem permissão administrativa. As funções do painel ficam disponíveis somente para administradores autorizados.
    </p>
    <a id="voltar" href={url("/minha-area")} class={botao}>
      <ArrowLeft class="size-[18px]" aria-hidden="true" />
      Voltar para Minha área
    </a>
  </div>
</Base>

<script>
  import { sessao } from "../../lib/api";
  import { caminho } from "../../lib/admin-api";

  const s = sessao();
  if (!s) location.replace(caminho("/admin/entrar"));
  else if (s.usuario.papel === "admin") location.replace(caminho("/admin"));
  else document.getElementById("login")!.textContent = s.usuario.login;
</script>
