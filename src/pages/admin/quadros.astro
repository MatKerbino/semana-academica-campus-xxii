---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout titulo="Quadros" ativo="quadros">
  <div class="flex flex-col gap-1.5">
    <h1 class="text-[32px] leading-[1.3] font-bold text-verde-escuro max-lg:text-[26px]">Quadros de informação</h1>
    <p class="text-[15px] leading-normal text-chumbo">Cartões e passos da página inicial e grupos de realização e apoio.</p>
  </div>
  <div id="conteudo" class="flex flex-col gap-6" aria-live="polite"><p class="text-sm text-texto-suave">Carregando…</p></div>
</AdminLayout>

<script>
  import { iniciarPainel } from "../../lib/admin-api";
  import { iniciarQuadros } from "../../lib/admin/conteudo/quadros";

  if (iniciarPainel()) iniciarQuadros(document.getElementById("conteudo")!);
</script>
