---
import banner from "../../assets/banner-semana-academica.png";
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout titulo="Aparência" ativo="aparencia">
  <div class="flex flex-col gap-1.5">
    <h1 class="text-[32px] leading-[1.3] font-bold text-verde-escuro max-lg:text-[26px]">Aparência</h1>
    <p class="text-[15px] leading-normal text-chumbo">Banner inicial, paleta de cores (pronta ou personalizada) e ícones do site.</p>
  </div>
  <div id="conteudo" data-banner-padrao={banner.src} class="flex flex-col gap-6" aria-live="polite"><p class="text-sm text-texto-suave">Carregando…</p></div>
</AdminLayout>

<script>
  import { iniciarPainel } from "../../lib/admin-api";
  import { iniciarAparencia } from "../../lib/admin/conteudo/aparencia";

  if (iniciarPainel()) {
    const raiz = document.getElementById("conteudo")!;
    iniciarAparencia(raiz, raiz.dataset.bannerPadrao ?? "");
  }
</script>
