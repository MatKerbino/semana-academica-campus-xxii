---
import AdminLayout from "../../layouts/AdminLayout.astro";
---

<AdminLayout titulo="Informações" ativo="informacoes">
  <div class="flex flex-col gap-1.5">
    <h1 class="text-[32px] leading-[1.3] font-bold text-verde-escuro max-lg:text-[26px]">Informações do evento</h1>
    <p class="text-[15px] leading-normal text-chumbo">Página de informações do evento: datas, edital, templates de submissão e outros avisos.</p>
  </div>
  <div id="conteudo" class="flex flex-col gap-6" aria-live="polite"><p class="text-sm text-texto-suave">Carregando…</p></div>
</AdminLayout>

<script>
  import { iniciarPainel } from "../../lib/admin-api";
  import { iniciarInformacoes } from "../../lib/admin/conteudo/informacoes";

  if (iniciarPainel()) iniciarInformacoes(document.getElementById("conteudo")!);
</script>
