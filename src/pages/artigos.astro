---
import { url } from "../lib/url";
import { ArrowRight } from "@lucide/astro";
import PaginaCabecalho from "../components/PaginaCabecalho.astro";
import Base from "../layouts/Base.astro";
---

<Base titulo="Artigos e Materiais" ativo="/artigos">
  <PaginaCabecalho
    titulo="Artigos e Materiais do evento"
    descricao="Sessões de apresentação de trabalhos e trabalhos aprovados."
    trilha={[{ href: "/", rotulo: "Início" }]}
  />

  <div class="flex flex-col gap-5">
    <a href={url("/informacoes")} class="flex w-fit items-center gap-2 rounded-full border-2 border-verde-escuro bg-white px-[22px] py-2.5 text-[15px] font-bold text-verde-escuro hover:bg-palha">
      Edital, templates e prazos de submissão
      <ArrowRight class="size-4" aria-hidden="true" />
    </a>
    <div id="sessoes" class="grid gap-5 md:grid-cols-2"></div>
    <section class="flex flex-col gap-3">
      <h2 class="text-xl font-semibold text-verde-escuro">Trabalhos aprovados</h2>
      <div id="gts" class="flex flex-col gap-3"></div>
    </section>
  </div>
</Base>

<script>
  import { iniciar } from "../lib/paginas/artigos";
  iniciar();
</script>
