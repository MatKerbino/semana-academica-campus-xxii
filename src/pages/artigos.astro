---
import { url } from "../lib/url";
import { ArrowRight, CalendarClock, Download, ExternalLink, FileText } from "@lucide/astro";
import Abas from "../components/Abas.astro";
import PaginaCabecalho from "../components/PaginaCabecalho.astro";
import Base from "../layouts/Base.astro";
import { areasGt, gtsTrabalhos, horarioCompleto, linkAtividade, materiais, porTipo, prazos } from "../data/evento";

/* Sessões de apresentação de trabalhos: comunicação oral (GTs) e pôsteres. Dados do Even3. */
const sessoes = porTipo("artigo", "banner");
const hoje = new Date().toISOString().slice(0, 10);
---

<Base titulo="Artigos e Materiais" ativo="/artigos">
  <PaginaCabecalho
    titulo="Artigos e Materiais do evento"
    descricao="Sessões de apresentação de trabalhos, trabalhos aprovados, edital e templates e prazos de submissão."
    trilha={[{ href: "/", rotulo: "Início" }]}
  />

  <Abas
    rotuloLista="Artigos e materiais"
    abas={[
      { id: "sessoes", rotulo: "Sessões de artigos" },
      { id: "templates", rotulo: "Templates e modelos" },
      { id: "prazos", rotulo: "Submissão de trabalhos" },
    ]}
  >
    <div data-painel="sessoes" class="flex flex-col gap-5">
      <div class="grid gap-5 md:grid-cols-2">
        {
          sessoes.map((a) => (
            <article class="flex flex-col gap-1.5 rounded-cartao border border-verde-medio bg-palha p-4">
              <FileText class="size-6 text-verde-escuro" aria-hidden="true" />
              <span class="w-fit rounded-full bg-creme px-2.5 py-0.5 text-xs font-bold text-verde-escuro">
                {horarioCompleto(a).replace(" às ", "–")}
              </span>
              <h2 class="text-lg leading-[1.3] font-semibold text-verde-escuro">{a.titulo}</h2>
              {a.descricao[0] && <p class="text-[15px] text-chumbo">{a.descricao[0]}</p>}
              <div class="mt-auto flex items-center justify-between gap-2 pt-1 text-[13px]">
                <span class="text-chumbo/80">{a.local ?? ""}</span>
                <a href={url(linkAtividade(a.slug))} class="flex items-center gap-1 font-semibold text-azul hover:underline">
                  Ver página da atividade
                  <ArrowRight class="size-3.5" aria-hidden="true" />
                </a>
              </div>
            </article>
          ))
        }
      </div>

      <section class="flex flex-col gap-3">
        <h2 class="text-xl font-semibold text-verde-escuro">Trabalhos aprovados</h2>
        {
          areasGt.map((gt) => (
            <div class="rounded-cartao border border-borda bg-white p-4">
              <h3 class="text-base font-bold text-verde-escuro">{gt.id}: {gt.nome}</h3>
              {gtsTrabalhos
                .filter((b) => b.gt === gt.id)
                .map((bloco) => (
                  <details class="mt-2">
                    <summary class="cursor-pointer text-tabela font-semibold text-verde-medio">
                      {bloco.forma === "oral" ? "Comunicação oral" : "Pôster"} ({bloco.trabalhos.length})
                    </summary>
                    <ul class="mt-2 space-y-2">
                      {bloco.trabalhos.map((t) => (
                        <li class="text-sm text-chumbo">
                          <span class="font-semibold">{t.titulo}</span>
                          <span class="block text-tabela text-chumbo/75">{t.autores}</span>
                        </li>
                      ))}
                    </ul>
                  </details>
                ))}
            </div>
          ))
        }
      </section>
    </div>

    <div data-painel="templates" class="grid gap-5 md:grid-cols-2">
      {
        materiais.map((material) => (
          <article class="flex flex-col rounded-cartao border border-borda bg-white p-6">
            <h2 class="text-lg font-semibold text-verde-escuro">{material.nome}</h2>
            <p class="mt-2 text-tabela text-chumbo/75">{material.descricao}</p>
            <a
              href={material.url}
              target="_blank"
              rel="noopener"
              class="mt-4 flex items-center justify-center gap-2 rounded-full bg-verde-cta px-4 py-2 text-tabela font-bold text-verde-escuro"
            >
              <Download class="size-4" aria-hidden="true" />
              Abrir no Even3
              <ExternalLink class="size-3.5" aria-hidden="true" />
            </a>
          </article>
        ))
      }
    </div>

    <div data-painel="prazos">
      <h2 class="text-xl font-semibold text-verde-escuro">Submissão de trabalhos</h2>

      <div class="mt-3 grid gap-4 sm:grid-cols-2">
        {
          prazos.map((prazo) => (
            <article class="rounded-cartao border border-borda bg-white p-4">
              <CalendarClock class="size-5 text-verde-medio" aria-hidden="true" />
              <p class="mt-1.5 text-base font-bold text-verde-medio">{prazo.data}</p>
              <p class="mt-1 text-tabela text-chumbo">{prazo.etapa}</p>
              {prazo.fim < hoje && (
                <span class="mt-2 inline-block rounded-full bg-[#eeeeee] px-2.5 py-0.5 text-xs font-bold text-chumbo uppercase">Encerrado</span>
              )}
            </article>
          ))
        }
      </div>

      <h3 class="mt-5 text-base font-semibold text-verde-escuro">Áreas temáticas (grupos de trabalho)</h3>
      <ul class="mt-2 space-y-2">
        {
          areasGt.map((gt) => (
            <li class="flex gap-2 text-sm text-chumbo">
              <span class="mt-2 size-1.5 shrink-0 rounded-full bg-verde-medio" aria-hidden="true" />
              <span><span class="font-semibold">{gt.id}:</span> {gt.nome}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </Abas>
</Base>
