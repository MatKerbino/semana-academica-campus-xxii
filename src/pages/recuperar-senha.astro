---
import { ArrowLeft, KeyRound, Mail, MailCheck } from "@lucide/astro";
import { url } from "../lib/url";
import Alerta from "../components/Alerta.astro";
import Campo from "../components/Campo.astro";
import CartaoAcesso from "../components/CartaoAcesso.astro";
import { evento } from "../data/evento";

const botao = "flex w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-verde-cta px-[22px] py-3 text-[15px] leading-[1.3] font-bold text-verde-noite hover:brightness-95 disabled:opacity-60";
const voltar = "flex items-center justify-center gap-2 rounded-full px-2 py-3 text-[15px] font-bold text-verde-medio hover:underline";
---

<CartaoAcesso titulo="Recuperar acesso" descricao="Informe o seu login. Enviaremos um link para redefinir a senha ao e-mail informado na sua inscrição. Por segurança, a senha atual nunca é exibida." ativo="/entrar">
  <KeyRound slot="icone" class="size-8" aria-hidden="true" />
  <form id="form" novalidate class="flex w-full flex-col gap-4">
    <Alerta tipo="erro" titulo="Não foi possível enviar" geral />
    <Campo nome="login" rotulo="Login" icone="usuario" placeholder="Digite seu login" autocomplete="username" />
    <button type="submit" class={botao}>
      <Mail class="size-[18px]" aria-hidden="true" />
      Enviar link de redefinição
    </button>
    <p class="text-[13px] leading-normal text-texto-suave">Ainda não fez a inscrição? Procure a comissão organizadora: {evento.email}</p>
    <a href={url("/entrar")} class={voltar}>
      <ArrowLeft class="size-[18px]" aria-hidden="true" />
      Voltar para o login
    </a>
  </form>

  <div id="enviado" hidden class="flex w-full flex-col items-center gap-4 text-center">
    <div class="flex size-16 items-center justify-center rounded-full bg-info-fundo text-info-texto">
      <MailCheck class="size-8" aria-hidden="true" />
    </div>
    <h2 class="text-[32px] leading-[1.3] font-bold text-verde-escuro">Verifique seu e-mail</h2>
    <p class="text-[15px] leading-normal text-chumbo">
      Se o login informado estiver associado a uma inscrição, enviaremos um link para redefinir a senha. O link é de uso único e tem validade limitada.
    </p>
    <p class="text-[13px] leading-normal text-texto-suave">Caso não encontre o e-mail, verifique a pasta de spam ou lixo eletrônico.</p>
    <a href={url("/entrar")} class={voltar}>
      <ArrowLeft class="size-[18px]" aria-hidden="true" />
      Voltar para o login
    </a>
  </div>
</CartaoAcesso>

<script>
  import { api, erroCampos, limparErro, mostrarErro } from "../lib/api";
  const form = document.querySelector<HTMLFormElement>("#form")!;
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    limparErro(form);
    const login = String(new FormData(form).get("login") ?? "").trim().toLowerCase();
    if (!login) return mostrarErro(form, erroCampos({ login: "Informe o seu login." }));
    const botao = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    botao.disabled = true;
    try {
      await api("/recuperar-senha", { metodo: "POST", corpo: { login }, auth: false });
      form.hidden = true;
      document.querySelector<HTMLElement>("[data-cabecalho]")!.hidden = true;
      document.querySelector<HTMLElement>("#enviado")!.hidden = false;
    } catch (err) {
      mostrarErro(form, err);
    } finally {
      botao.disabled = false;
    }
  });
</script>
