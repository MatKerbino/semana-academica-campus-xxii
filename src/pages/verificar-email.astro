---
import { CircleX, ListChecks, MailCheck } from "@lucide/astro";
import { url } from "../lib/url";
import Base from "../layouts/Base.astro";

const botao = "flex w-full items-center justify-center gap-2 rounded-full bg-verde-cta px-[22px] py-3 text-[15px] leading-[1.3] font-bold text-verde-noite hover:brightness-95";
---

<Base titulo="E-mail verificado" espaco="acesso">
  <div class="mx-auto flex w-full max-w-[480px] flex-col items-center gap-4 rounded-cartao border border-borda bg-white p-6 text-center shadow-[0_1px_3px_rgba(15,41,8,0.08)] sm:p-9">
    <p id="verificando" class="text-[15px] text-chumbo" role="status">Verificando seu e-mail…</p>

    <div id="ok" hidden class="flex w-full flex-col items-center gap-4">
      <div class="flex size-[56px] items-center justify-center rounded-full bg-verde-claro text-verde-escuro">
        <MailCheck class="size-7" aria-hidden="true" />
      </div>
      <h1 class="text-[28px] leading-[1.3] font-bold text-verde-escuro">E-mail verificado</h1>
      <p class="text-[15px] leading-normal text-chumbo">
        O endereço <span data-email></span> foi confirmado. As comunicações do evento serão enviadas para ele.
      </p>
      <a href={url("/minha-inscricao")} class={botao}>
        <ListChecks class="size-[18px]" aria-hidden="true" />
        Ver minha inscrição
      </a>
    </div>

    <div id="falha" hidden class="flex w-full flex-col items-center gap-4">
      <div class="flex size-[56px] items-center justify-center rounded-full bg-erro-fundo text-erro">
        <CircleX class="size-7" aria-hidden="true" />
      </div>
      <h1 class="text-[28px] leading-[1.3] font-bold text-verde-escuro">Não foi possível verificar</h1>
      <p class="text-[15px] leading-normal text-chumbo">Link inválido ou expirado. Peça um novo e-mail de verificação em Minha inscrição.</p>
      <a href={url("/minha-inscricao")} class={botao}>Ir para Minha inscrição</a>
    </div>
  </div>
</Base>

<script>
  import { api } from "../lib/api";
  const token = new URLSearchParams(location.search).get("token") ?? "";
  const mostrar = (id: string) => {
    document.getElementById("verificando")!.hidden = true;
    document.getElementById(id)!.hidden = false;
  };
  api<{ email: string }>("/verificar-email", { metodo: "POST", corpo: { token }, auth: false })
    .then((r) => {
      document.querySelector("[data-email]")!.textContent = r.email;
      mostrar("ok");
    })
    .catch(() => mostrar("falha"));
</script>
