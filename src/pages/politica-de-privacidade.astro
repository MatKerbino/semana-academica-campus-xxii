---
import { ArrowLeft } from "@lucide/astro";
import Base from "../layouts/Base.astro";
import PaginaCabecalho from "../components/PaginaCabecalho.astro";
import PoliticaTexto from "../components/PoliticaTexto.astro";
---

<Base titulo="Política de Privacidade" espaco="acesso">
  <div class="mx-auto w-full max-w-[720px]">
    <PaginaCabecalho simples titulo="Política de Privacidade" descricao="Como a 1ª Semana Acadêmica do Campus XXII trata os dados de quem cria conta e se inscreve no evento." />
    <div class="mt-5 rounded-cartao border border-borda bg-white p-8 shadow-[0_1px_3px_rgba(15,41,8,0.08)]">
      <PoliticaTexto />
    </div>
    <button
      type="button"
      onclick="history.length > 1 ? history.back() : (location.href = document.querySelector('header a').href)"
      class="mt-5 inline-flex cursor-pointer items-center gap-2 rounded-full border-2 border-verde-escuro bg-white px-[22px] py-2.5 text-[15px] font-bold text-verde-escuro hover:bg-palha"
    >
      <ArrowLeft class="size-[18px]" aria-hidden="true" />
      Voltar
    </button>
  </div>
</Base>
