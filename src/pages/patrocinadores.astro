---
import { Building2, ExternalLink, Mail } from "@lucide/astro";
import Abas from "../components/Abas.astro";
import PaginaCabecalho from "../components/PaginaCabecalho.astro";
import Base from "../layouts/Base.astro";
import { cotas, evento, patrocinadores } from "../data/evento";

const colunas = (n: number) =>
  n <= 2 ? "sm:grid-cols-2" : n === 3 ? "sm:grid-cols-2 lg:grid-cols-3" : "sm:grid-cols-2 lg:grid-cols-4";

const contato = `mailto:${evento.email}?subject=${encodeURIComponent("Patrocínio — 1ª Semana Acadêmica do Campus XXII")}`;
---

<Base titulo="Patrocinadores e Apoiadores" ativo="/patrocinadores">
  <PaginaCabecalho
    titulo="Patrocinadores e Apoiadores"
    descricao="Marcas, empresas e instituições que viabilizam a 1ª Semana Acadêmica do Campus XXII."
    trilha={[{ href: "/", rotulo: "Início" }]}
  />

  <Abas
    rotuloLista="Cotas de patrocínio"
    abas={[...cotas.map((cota) => ({ id: cota, rotulo: cota })), { id: "seja", rotulo: "Seja um patrocinador" }]}
  >
    {
      cotas.map((cota) => {
        const lista = patrocinadores.filter((p) => p.cota === cota);
        return (
          <div data-painel={cota} class:list={["grid gap-4", colunas(lista.length)]}>
            {lista.map((p) => (
              <article class="flex flex-col items-center rounded-cartao border border-borda bg-white p-4">
                <span class="flex h-16 w-full items-center justify-center rounded-cartao bg-creme" aria-hidden="true">
                  <Building2 class="size-7 text-verde-medio" />
                </span>
                <h2 class="mt-3 text-center text-sm font-semibold text-verde-escuro">{p.nome}</h2>
                <a
                  href={p.url}
                  target="_blank"
                  rel="noopener"
                  class="mt-1.5 flex items-center gap-1.5 text-tabela font-semibold text-azul hover:underline"
                >
                  <ExternalLink class="size-3.5" aria-hidden="true" />
                  Visitar site
                </a>
              </article>
            ))}
          </div>
        );
      })
    }

    <div data-painel="seja" class="rounded-cartao bg-creme p-6">
      <h2 class="text-xl font-semibold text-verde-escuro">Seja um patrocinador</h2>
      <p class="mt-2 max-w-[900px] text-sm text-chumbo">
        Empresas e instituições interessadas em apoiar a próxima edição podem solicitar o plano de cotas pelo e-mail da
        organização.
      </p>
      <a
        href={contato}
        class="mt-4 inline-flex items-center gap-2 rounded-full bg-azul px-6 py-2.5 text-[15px] font-semibold text-white hover:opacity-90"
      >
        <Mail class="size-4" aria-hidden="true" />
        Falar com a organização
      </a>
    </div>
  </Abas>
</Base>
