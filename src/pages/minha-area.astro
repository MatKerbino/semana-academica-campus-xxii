---
import Base from "../layouts/Base.astro";
import IconesCliente from "../components/IconesCliente.astro";
---

<Base titulo="Minha área" espaco="acesso">
  <div id="conteudo" hidden class="mx-auto flex w-full max-w-[880px] flex-col gap-5">
    <div>
      <p class="text-[13px] leading-normal text-texto-suave">Minha área</p>
      <h1 class="text-[32px] leading-[1.3] font-bold text-verde-escuro">Olá, <span data-login></span></h1>
      <p class="mt-1 text-[15px] text-chumbo">Esta é a sua área de participante.</p>
    </div>
    <section id="estado" class="rounded-cartao border border-borda bg-white p-6 shadow-[0_1px_3px_rgba(15,41,8,0.08)]"></section>
    <section class="rounded-cartao border border-borda bg-white p-6 shadow-[0_1px_3px_rgba(15,41,8,0.08)]">
      <h2 class="text-[18px] leading-[1.4] font-semibold text-verde-escuro">Forma de participação</h2>
      <div id="forma" class="mt-4"></div>
      <p class="mt-4 text-[13px] leading-normal text-texto-suave">Forma de participação vigente, definida pela organização e igual para todos os inscritos.</p>
    </section>
    <section class="rounded-cartao border border-borda bg-white p-6 shadow-[0_1px_3px_rgba(15,41,8,0.08)]">
      <h2 class="text-[18px] leading-[1.4] font-semibold text-verde-escuro">Minha conta</h2>
      <div class="mt-3 grid gap-x-6 gap-y-3 sm:grid-cols-2">
        <div><p class="text-[13px] leading-normal text-texto-suave">Login</p><p class="text-[15px] text-chumbo" data-login></p></div>
        <div id="criada-em" hidden><p class="text-[13px] leading-normal text-texto-suave">Conta criada em</p><p class="text-[15px] text-chumbo" data-criada-em></p></div>
      </div>
    </section>
  </div>
  <p id="erro" role="alert" hidden class="mx-auto max-w-[880px] rounded-campo border border-erro-borda bg-erro-fundo p-4 text-erro"></p>
  <IconesCliente />
</Base>

<script>
  import { api, ApiError, exigirLogin, formatarData, formatarDataHora, type Inscricao, type Pagamento } from "../lib/api";
  import { btnPrimario, formaParticipacao, ico, passos, selo, seloInscricao } from "../lib/visao";
  import { url } from "../lib/url";

  const sessao = exigirLogin();
  if (sessao) {
    document.querySelectorAll("[data-login]").forEach((el) => (el.textContent = sessao.usuario.login));
    carregar();
  }

  function etapa(i: Inscricao): 1 | 2 | 3 {
    const d = i.dados;
    const completos = d.nome && d.cpf && d.email && d.telefone && d.dataNascimento && d.perfil;
    if (!completos || !i.aceitePrivacidade) return 1;
    return i.atividades.length ? 3 : 2;
  }

  const cabecalho = (icone: string, fundo: string, corIcone: string) =>
    `<span class="flex size-[44px] shrink-0 items-center justify-center rounded-full ${fundo} ${corIcone}">${ico(icone, "size-6")}</span>`;

  function cartaoEstado(i: Inscricao | null): string {
    if (!i)
      return `<div class="flex gap-4">${cabecalho("usuario-mais", "bg-verde-claro", "text-verde-escuro")}<div class="min-w-0 flex-1">
        ${selo("cinza", "proibido", "Sem inscrição")}
        <h2 class="mt-1 text-[18px] leading-[1.4] font-semibold text-verde-escuro">Você ainda não tem inscrição na Semana Acadêmica</h2>
        <p class="mt-1 text-[15px] leading-normal text-chumbo">Sua conta está ativa, mas criar a conta não faz a inscrição. Inicie a inscrição para informar seus dados, aceitar a Política de Privacidade e escolher as atividades.</p>
        <a href="${url("/inscricao")}" class="${btnPrimario} mt-4">${ico("usuario-mais", "size-4")}Iniciar inscrição</a></div></div>`;
    if (i.status === "rascunho") {
      const e = etapa(i);
      const nomes = ["Dados e política", "Atividades", "Revisão e confirmação"];
      return `<div class="flex gap-4">${cabecalho("relogio", "bg-pendente-fundo", "text-pendente-texto")}<div class="min-w-0 flex-1">
        ${seloInscricao("rascunho")}
        <h2 class="mt-1 text-[18px] leading-[1.4] font-semibold text-verde-escuro">Sua inscrição ainda não foi confirmada</h2>
        <p class="mt-1 text-[15px] leading-normal text-chumbo">Você parou na etapa ${e} de 3 (${nomes[e - 1]}). Dados salvos em ${formatarDataHora(i.atualizadaEm).replace(", ", " às ").replace(":", "h")}. A inscrição só é registrada depois da confirmação.</p>
        <div class="mt-4">${passos(e)}</div>
        <a href="${url("/inscricao")}" class="${btnPrimario} mt-4">${ico("lista", "size-4")}Continuar inscrição</a></div></div>`;
    }
    const cancelada = i.status === "cancelada";
    return `<div class="flex gap-4">${cabecalho(cancelada ? "circulo-x" : "circulo-ok", cancelada ? "bg-[#eeeeee]" : "bg-verde-claro", "text-verde-escuro")}<div class="min-w-0 flex-1">
      ${seloInscricao(i.status)}
      <h2 class="mt-1 text-[18px] leading-[1.4] font-semibold text-verde-escuro">${cancelada ? "Sua inscrição foi cancelada" : "Sua inscrição está confirmada"}</h2>
      <p class="mt-1 text-[15px] leading-normal text-chumbo">Inscrição nº ${i.numero ?? "—"} · ${cancelada ? `cancelada em ${formatarData(i.canceladaEm)}` : `confirmada em ${formatarData(i.confirmadaEm)}`}.</p>
      <a href="${url("/minha-inscricao")}" class="${btnPrimario} mt-4">${ico("lista", "size-4")}Ver minha inscrição</a></div></div>`;
  }

  async function carregar() {
    try {
      const [pagamento, inscricao, me] = await Promise.all([
        api<Pagamento>("/pagamento", { auth: false }),
        api<{ inscricao: Inscricao }>("/inscricao").then((r) => r.inscricao).catch((e) => {
          if (e instanceof ApiError && e.status === 404) return null;
          throw e;
        }),
        api<{ criadoEm?: string }>("/me").catch(() => ({}) as { criadoEm?: string }),
      ]);
      document.getElementById("estado")!.innerHTML = cartaoEstado(inscricao);
      document.getElementById("forma")!.innerHTML = formaParticipacao(inscricao?.pagamento ?? pagamento);
      if (me.criadoEm) {
        document.querySelector("[data-criada-em]")!.textContent = formatarData(me.criadoEm);
        document.getElementById("criada-em")!.hidden = false;
      }
      document.getElementById("conteudo")!.hidden = false;
    } catch (e) {
      const erro = document.getElementById("erro")!;
      erro.textContent = e instanceof Error ? e.message : "Não foi possível carregar a sua área.";
      erro.hidden = false;
    }
  }
</script>
