---
import { url } from "../lib/url";
import {
  Apple,
  ArrowRight,
  Award,
  Building2,
  CalendarDays,
  FileText,
  GraduationCap,
  Image,
  Mail,
  MapPin,
  Presentation,
  Users,
} from "@lucide/astro";
import Abas from "../components/Abas.astro";
import Ornamento from "../components/Ornamento.astro";
import Base from "../layouts/Base.astro";
import { evento, porTipo } from "../data/evento";

const inscricao = `mailto:${evento.email}?subject=${encodeURIComponent("Inscrição — 1ª Semana Acadêmica do Campus XXII")}`;

const destaques = [
  { icone: Users, titulo: "Aberto a todos", texto: evento.publico },
  { icone: Apple, titulo: "Custo simbólico", texto: `A participação custa ${evento.custo}` },
  {
    icone: Mail,
    titulo: "Inscrição por e-mail",
    texto: "O site não realiza cadastro nem processamento automático: a inscrição é feita manualmente por e-mail.",
  },
];

const passos = [
  {
    titulo: "Envie um e-mail",
    texto: `Escreva para ${evento.email} informando nome completo, curso/instituição e as atividades desejadas.`,
  },
  {
    titulo: "Aguarde a confirmação",
    texto: "A organização responde por e-mail confirmando a vaga nas atividades com número limitado de participantes.",
  },
  {
    titulo: "Entregue 1 kg de alimento",
    texto: "No credenciamento, entregue 1 kg de alimento não perecível e retire seu crachá de participante.",
  },
];

const atalhos = [
  {
    href: "/minicursos",
    rotulo: "Minicursos",
    resumo: `${porTipo("minicurso").length} minicursos práticos`,
    icone: GraduationCap,
  },
  {
    href: "/palestras",
    rotulo: "Palestras",
    resumo: `${porTipo("palestra", "mesa-redonda").length} palestras e mesa-redonda`,
    icone: Presentation,
  },
  {
    href: "/cursos",
    rotulo: "Cursos",
    resumo: `${porTipo("curso").length} cursos de extensão (8h)`,
    icone: Award,
  },
  { href: "/banners", rotulo: "Exposição de Banners", resumo: "Pôsteres de pesquisa", icone: Image },
  { href: "/artigos", rotulo: "Artigos e Materiais", resumo: "Templates e submissões", icone: FileText },
];
---

<Base titulo="Página Inicial" ativo="/">
  <!-- Hero (tela 01 do protótipo): selos, título de 40px, ações primária e secundária. -->
  <section class="relative overflow-hidden rounded-cartao bg-creme p-5">
    <Ornamento />
    <div class="relative">
    <div class="flex flex-wrap gap-2.5 text-xs font-semibold">
      <span class="flex items-center gap-[7px] rounded-full bg-verde-escuro px-3.5 py-1 text-white">
        <CalendarDays class="size-3.5" aria-hidden="true" />
        {evento.periodo}
      </span>
      <span class="flex items-center gap-[7px] rounded-full bg-verde-medio px-3.5 py-1 text-white">
        <Building2 class="size-3.5" aria-hidden="true" />
        Campus XXII — Ananindeua/PA
      </span>
      <span class="flex items-center gap-[7px] rounded-full bg-white px-3.5 py-1 text-verde-escuro">
        <Apple class="size-3.5" aria-hidden="true" />
        Inscrição: 1 kg de alimento não perecível
      </span>
    </div>

    <h1 class="mt-2 text-[28px] font-bold text-verde-escuro lg:text-hero">{evento.nome}</h1>
    <p class="mt-2 max-w-[900px] text-[17px] text-chumbo">
      Quatro dias de palestras, minicursos, cursos, exposição de banners e apresentação de artigos promovidos pela
      UEPA. Aberto à comunidade interna e externa, com participação garantida mediante inscrição por e-mail.
    </p>

    <div class="mt-4 flex flex-wrap gap-3.5">
      <a
        href={inscricao}
        class="flex items-center gap-2 rounded-full bg-verde-cta px-7 py-2.5 text-[15px] font-semibold text-verde-noite shadow transition-transform hover:scale-[1.03]"
      >
        <Mail class="size-4" aria-hidden="true" />
        Realizar Inscrição
      </a>
      <a
        href={url("/cronograma")}
        class="flex items-center gap-2 rounded-full border-2 border-verde-escuro px-7 py-2.5 text-[15px] font-semibold text-verde-escuro hover:bg-white"
      >
        <CalendarDays class="size-4" aria-hidden="true" />
        Ver Cronograma Completo
      </a>
      </div>
    </div>
  </section>

  <section class="mt-3">
    <Abas
      rotuloLista="Informações do evento"
      abas={[
        { id: "sobre", rotulo: "Sobre o evento" },
        { id: "inscricao", rotulo: "Como se inscrever" },
        { id: "atividades", rotulo: "Atividades do evento" },
        { id: "local", rotulo: "Local" },
      ]}
    >
      <div data-painel="sobre">
        <h2 class="sr-only">Sobre o evento</h2>
        <p class="max-w-[1000px] text-sm text-chumbo">{evento.descricao}</p>

        <div class="mt-3 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
          {
            destaques.map((destaque) => (
              <article class="rounded-cartao border border-borda bg-white p-3.5">
                <destaque.icone class="size-[26px] text-verde-escuro" aria-hidden="true" />
                <h3 class="mt-2 text-lg font-semibold text-verde-escuro">{destaque.titulo}</h3>
                <p class="mt-1.5 text-sm text-chumbo">{destaque.texto}</p>
              </article>
            ))
          }
          <article class="rounded-cartao bg-verde-escuro p-3.5 text-white">
            <h3 class="text-lg font-semibold">Tema da Semana Acadêmica</h3>
            <p class="mt-1.5 text-sm text-white/85">“{evento.lema}”</p>
            <p class="mt-2 text-tabela text-verde-claro">Realização: {evento.realizacao.join(" · ")}</p>
          </article>
        </div>
      </div>

      <div data-painel="inscricao">
        <h2 class="sr-only">Como realizar a inscrição</h2>

        <div class="mt-3 grid gap-4 md:grid-cols-3">
          {
            passos.map((passo, i) => (
              <article class="rounded-cartao border border-borda bg-white p-3.5">
                <span class="inline-flex rounded-full bg-verde-medio px-3.5 py-1.5 text-sm font-bold text-white">
                  {i + 1}
                </span>
                <h3 class="mt-2 text-lg font-semibold text-verde-escuro">{passo.titulo}</h3>
                <p class="mt-1.5 text-sm text-chumbo">{passo.texto}</p>
              </article>
            ))
          }
        </div>

        <div class="mt-4 flex w-fit flex-wrap items-center gap-4 rounded-xl border-2 border-azul bg-white px-6 py-3">
          <Mail class="size-5 text-azul" aria-hidden="true" />
          <span class="text-[15px] font-semibold text-verde-escuro">E-mail para inscrição:</span>
          <a href={inscricao} class="text-base font-bold text-azul hover:underline">{evento.email}</a>
        </div>
        <p class="mt-2 text-sm text-chumbo">
          O site é apenas informativo: não há cadastro, login ou processamento automático de inscrições.
        </p>
      </div>

      <div data-painel="atividades">
        <h2 class="sr-only">Atividades do evento</h2>

        <div class="mt-3 grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
          {
            atalhos.map((atalho) => (
              <a
                href={url(atalho.href)}
                class="flex flex-col gap-2 rounded-cartao bg-creme px-5 py-[22px] transition-shadow hover:shadow-md"
              >
                <atalho.icone class="size-6 text-verde-escuro" aria-hidden="true" />
                <span class="text-lg font-semibold text-verde-escuro">{atalho.rotulo}</span>
                <span class="text-tabela text-chumbo">{atalho.resumo}</span>
                <span class="mt-auto flex items-center gap-1 text-tabela font-semibold text-azul">
                  Acessar página
                  <ArrowRight class="size-3.5" aria-hidden="true" />
                </span>
              </a>
            ))
          }
        </div>
      </div>

      <div data-painel="local">
        <div
          class="flex flex-wrap items-center justify-between gap-6 rounded-cartao bg-creme px-6 py-6 lg:px-10"
        >
          <div>
            <MapPin class="size-7 text-verde-escuro" aria-hidden="true" />
            <h2 class="mt-1 text-secao font-bold text-verde-escuro">Local do evento</h2>
            <p class="mt-1 text-sm text-chumbo">
              UEPA — Campus XXII, Rodovia BR-316, km 8 · Ananindeua/PA · CEP 67030-000
            </p>
            <p class="mt-1 text-sm text-chumbo/80">{evento.local.referencia}</p>
          </div>

          <div class="flex flex-col items-start gap-2">
            <a
              href={evento.local.mapsUrl}
              target="_blank"
              rel="noopener"
              class="flex items-center gap-2 rounded-full bg-azul px-7 py-3 text-[15px] font-semibold text-white hover:opacity-90"
            >
              <MapPin class="size-4" aria-hidden="true" />
              Abrir no Google Maps
            </a>
            <a href={url("/local")} class="flex items-center gap-1 text-tabela font-semibold text-verde-medio hover:underline">
              Página de localização
              <ArrowRight class="size-3.5" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </Abas>
  </section>
</Base>
