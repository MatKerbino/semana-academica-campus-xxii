---
import { url } from "../lib/url";
import { Calendar, LogIn, UserPlus } from "@lucide/astro";
import { Image as Imagem } from "astro:assets";
import Abas from "../components/Abas.astro";
import banner from "../assets/banner-semana-academica.png";
import Base from "../layouts/Base.astro";
import padrao from "../data/conteudo-padrao.json";

const titulo = "text-lg leading-[1.4] font-semibold text-verde-escuro";
const botaoPrimario =
  "flex items-center justify-center gap-2 rounded-full bg-verde-cta px-[22px] py-3 text-[15px] leading-[1.3] font-bold text-verde-noite hover:brightness-95";
const botaoSecundario =
  "flex items-center justify-center gap-2 rounded-full border-2 border-verde-escuro bg-white px-[22px] py-3 text-[15px] leading-[1.3] font-bold text-verde-escuro hover:bg-palha";
---

<Base titulo="Página Inicial" ativo="/" espaco="amplo">
  <div class="flex flex-col gap-5">
    <section class="flex flex-col items-center gap-8 rounded-cartao bg-creme p-5 md:p-7 lg:flex-row">
      <div class="flex min-w-0 flex-1 flex-col gap-3.5">
        <ul data-info class="flex flex-wrap gap-x-6 gap-y-2"></ul>
        <h1 data-t="{{nome}}" class="text-[32px] leading-[1.3] font-bold text-verde-escuro">{padrao.evento.nome}</h1>
        <p data-t="Palestras, minicursos, cursos, exposição de banners e apresentação de artigos · {{periodo}}." class="text-[15px] leading-normal text-chumbo">
          Palestras, minicursos, cursos, exposição de banners e apresentação de artigos.
        </p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a href={url("/cadastro")} data-inscreva class={botaoPrimario}>
            <UserPlus class="size-[18px]" aria-hidden="true" />
            Inscreva-se
          </a>
          <a href={url("/cronograma")} class={botaoSecundario}>
            <Calendar class="size-[18px]" aria-hidden="true" />
            Ver cronograma
          </a>
        </div>
      </div>

      <Imagem
        data-banner
        src={banner}
        widths={[520, 1040]}
        sizes="(min-width: 1024px) 520px, 100vw"
        format="webp"
        alt={padrao.aparencia.banner.alt.replace("{{nome}}", padrao.evento.nome)}
        class="h-auto w-full max-lg:max-w-[560px] max-lg:self-center shrink-0 rounded-cartao border border-borda object-cover lg:h-[208px] lg:w-[520px]"
      />
    </section>

    <Abas
      tamanho="grande"
      rotuloLista="Informações do evento"
      abas={[
        { id: "sobre", rotulo: "Sobre o evento" },
        { id: "inscricao", rotulo: "Como se inscrever" },
        { id: "atividades", rotulo: "Atividades do evento" },
        { id: "local", rotulo: "Local" },
      ]}
    >
      <div data-painel="sobre" class="flex flex-col gap-4">
        <div data-sobre class="grid gap-4 md:grid-cols-2 xl:grid-cols-4"></div>
      </div>

      <div data-painel="inscricao" class="flex flex-col gap-4">
        <div data-passos class="grid gap-4 md:grid-cols-3"></div>
        <div class="flex flex-col gap-3 pt-2 sm:flex-row">
          <a href={url("/cadastro")} data-inscreva data-inscreva-rotulo="Fazer minha inscrição" class={botaoPrimario}>
            <UserPlus class="size-[18px]" aria-hidden="true" />
            <span data-rotulo>Criar conta</span>
          </a>
          <a href={url("/entrar")} class={botaoSecundario}>
            <LogIn class="size-[18px]" aria-hidden="true" />
            Já tenho conta — Entrar
          </a>
        </div>
      </div>

      <div data-painel="atividades" class="flex flex-col gap-4">
        <div data-grupos class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5"></div>
        <div>
          <a href={url("/atividades")} class={botaoSecundario + " inline-flex"}>
            Ver todas as atividades
          </a>
        </div>
      </div>

      <div data-painel="local" data-local></div>
    </Abas>
  </div>
</Base>

<script>
  import { iniciarInicio } from "../lib/paginas/inicio";

  iniciarInicio();
</script>
