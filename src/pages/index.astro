---
import { url } from "../lib/url";
import {
  Apple,
  ArrowRight,
  Building2,
  CalendarDays,
  ClipboardList,
  MapPin,
  Users,
  UserPlus,
  ListChecks,
  CircleCheck,
} from "@lucide/astro";
import { Image as Imagem } from "astro:assets";
import Abas from "../components/Abas.astro";
import banner from "../assets/banner-semana-academica.png";
import Base from "../layouts/Base.astro";
import { evento } from "../data/evento";

const destaques = [
  { icone: Users, titulo: "Aberto a todos", texto: "Comunidade interna e externa da universidade, sem exigir vínculo com a UEPA." },
  { icone: Apple, titulo: "Participação", texto: evento.custo, custo: true },
];

const passos = [
  { icone: UserPlus, titulo: "Crie sua conta", texto: "Cadastre apenas um login e uma senha." },
  { icone: ListChecks, titulo: "Preencha a inscrição", texto: "Informe seus dados e escolha as atividades." },
  { icone: CircleCheck, titulo: "Confirme", texto: "Revise tudo, aceite a política de privacidade e confirme." },
];
---

<Base titulo="Página Inicial" ativo="/">
  <!-- Hero: título em destaque, informações do evento em texto simples (não parecem botões) e uma ação primária. -->
  <section class="rounded-cartao bg-creme p-5">
    <div class="grid items-center gap-6 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <ul class="flex flex-wrap gap-x-5 gap-y-1 text-tabela font-semibold text-verde-escuro">
          <li class="flex items-center gap-1.5">
            <CalendarDays class="size-4 text-verde-medio" aria-hidden="true" />
            {evento.periodo}
          </li>
          <li class="flex items-center gap-1.5">
            <Building2 class="size-4 text-verde-medio" aria-hidden="true" />
            Campus XXII — Ananindeua/PA
          </li>
        </ul>

        <h1 class="mt-3 text-[34px] leading-[1.15] font-extrabold text-verde-escuro lg:text-[46px]">{evento.nome}</h1>
        <p class="mt-3 max-w-[760px] text-base text-chumbo">
          Quatro dias de palestras, minicursos, cursos, banners e artigos. Aberto à comunidade interna e externa.
        </p>

        <div class="mt-5 flex flex-wrap gap-3.5">
          <a
            href={url("/inscricao")}
            class="flex items-center gap-2 rounded-full bg-verde-cta px-7 py-3 text-base font-bold text-verde-noite shadow transition-transform hover:scale-[1.03]"
          >
            <ClipboardList class="size-4" aria-hidden="true" />
            Realizar Inscrição
          </a>
          <a
            href={url("/cronograma")}
            class="flex items-center gap-2 rounded-full border-2 border-verde-escuro px-7 py-3 text-base font-semibold text-verde-escuro hover:bg-white"
          >
            Ver Cronograma
            <ArrowRight class="size-4" aria-hidden="true" />
          </a>
        </div>
      </div>

      <Imagem
        src={banner}
        widths={[460, 920]}
        sizes="(min-width: 1024px) 460px, 100vw"
        format="webp"
        alt="Banner oficial da 1ª Semana Acadêmica do Campus XXII — Educação, Saúde, Tecnologia e Meio Ambiente: soluções inteligentes para um mundo sustentável"
        class="w-full rounded-cartao border border-borda"
      />
    </div>
  </section>

  <section class="mt-3">
    <Abas
      rotuloLista="Informações do evento"
      abas={[
        { id: "sobre", rotulo: "Sobre o evento" },
        { id: "inscricao", rotulo: "Como se inscrever" },
        { id: "local", rotulo: "Local" },
      ]}
    >
      <div data-painel="sobre" class="grid gap-4 md:grid-cols-3">
        <article class="rounded-cartao border border-borda bg-white p-4 md:col-span-3">
          <h2 class="text-lg font-semibold text-verde-escuro">O evento</h2>
          <p class="mt-1.5 text-sm text-chumbo">{evento.descricao}</p>
        </article>
        {
          destaques.map((d) => (
            <article class="rounded-cartao border border-borda bg-white p-4">
              <d.icone class="size-[26px] text-verde-escuro" aria-hidden="true" />
              <h3 class="mt-2 text-lg font-semibold text-verde-escuro">{d.titulo}</h3>
              <p class="mt-1.5 text-sm text-chumbo" data-custo={d.custo ? "" : undefined}>{d.texto}</p>
            </article>
          ))
        }
        <article class="rounded-cartao bg-verde-escuro p-4 text-white">
          <h3 class="text-lg font-semibold">Tema</h3>
          <p class="mt-1.5 text-sm text-white/85">“{evento.lema}”</p>
        </article>
      </div>

      <div data-painel="inscricao">
        <h2 class="sr-only">Como realizar a inscrição</h2>
        <div class="grid gap-4 md:grid-cols-3">
          {
            passos.map((passo, i) => (
              <article class="rounded-cartao border border-borda bg-white p-4">
                <div class="flex items-center gap-2">
                  <span class="inline-flex size-7 items-center justify-center rounded-full bg-verde-medio text-sm font-bold text-white">
                    {i + 1}
                  </span>
                  <passo.icone class="size-5 text-verde-escuro" aria-hidden="true" />
                </div>
                <h3 class="mt-2 text-lg font-semibold text-verde-escuro">{passo.titulo}</h3>
                <p class="mt-1 text-sm text-chumbo">{passo.texto}</p>
              </article>
            ))
          }
        </div>
        <div class="mt-4 flex flex-wrap items-center justify-between gap-3 rounded-cartao bg-creme p-4">
          <p class="text-sm text-chumbo">Já tem conta? Entre para continuar ou consultar sua inscrição.</p>
          <a href={url("/inscricao")} class="flex items-center gap-1 text-sm font-semibold text-azul hover:underline">
            Ir para a inscrição
            <ArrowRight class="size-4" aria-hidden="true" />
          </a>
        </div>
      </div>

      <div data-painel="local">
        <div class="flex flex-wrap items-center justify-between gap-6 rounded-cartao bg-creme px-6 py-6 lg:px-10">
          <div>
            <MapPin class="size-7 text-verde-escuro" aria-hidden="true" />
            <h2 class="mt-1 text-secao font-bold text-verde-escuro">Local do evento</h2>
            <p class="mt-1 text-sm text-chumbo">
              {evento.local.nome}, {evento.local.endereco} · {evento.local.cidade}
            </p>
          </div>
          <div class="flex flex-col items-start gap-2">
            <a
              href={evento.local.mapsUrl}
              target="_blank"
              rel="noopener"
              class="flex items-center gap-2 rounded-full bg-azul px-7 py-3 text-[15px] font-semibold text-white hover:opacity-90"
            >
              <MapPin class="size-4" aria-hidden="true" />
              Abrir no Google Maps
            </a>
            <a href={url("/local")} class="flex items-center gap-1 text-tabela font-semibold text-verde-medio hover:underline">
              Página de localização
              <ArrowRight class="size-3.5" aria-hidden="true" />
            </a>
          </div>
        </div>
      </div>
    </Abas>
  </section>
</Base>
