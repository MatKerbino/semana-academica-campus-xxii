---
import { TriangleAlert } from "@lucide/astro";
import IconesCliente from "../components/IconesCliente.astro";
import PaginaCabecalho from "../components/PaginaCabecalho.astro";
import Base from "../layouts/Base.astro";
import { catalogoSelecionavel } from "../data/evento";
import { url } from "../lib/url";
---

<Base titulo="Minha inscrição" espaco="acesso">
  <script type="application/json" id="catalogo" set:html={JSON.stringify(catalogoSelecionavel)} />

  <div id="conteudo" hidden class="mx-auto flex w-full max-w-[1120px] flex-col gap-5">
    <PaginaCabecalho titulo="Minha inscrição" trilha={[{ href: "/", rotulo: "Início" }, { href: "/minha-area", rotulo: "Minha área" }]}>
      <p id="resumo" class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-2 text-[13px] leading-normal text-chumbo"></p>
    </PaginaCabecalho>

    <div id="aviso-topo"></div>

    <div class="grid items-start gap-5 lg:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
      <div class="flex flex-col gap-5">
        <section class="rounded-cartao border border-borda bg-white p-6 shadow-[0_1px_3px_rgba(15,41,8,0.08)]">
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-[18px] leading-[1.4] font-semibold text-verde-escuro">Dados da inscrição</h2>
            <a id="editar-dados" hidden href={url("/editar-dados")} class="inline-flex items-center gap-2 text-[15px] font-bold text-verde-medio hover:underline"><span data-ico="lapis"></span>Editar dados</a>
          </div>
          <div id="dados" class="mt-4"></div>
          <div class="mt-4 flex flex-wrap items-center gap-2 text-[13px] text-texto-suave">
            E-mail: <span id="selo-email"></span>
            <button type="button" id="reenviar" hidden class="cursor-pointer font-bold text-verde-medio hover:underline">Reenviar e-mail de verificação</button>
            <span id="reenvio-status" role="status" class="text-verde-medio"></span>
          </div>
        </section>

        <section class="rounded-cartao border border-borda bg-white p-6 shadow-[0_1px_3px_rgba(15,41,8,0.08)]">
          <div class="flex items-center justify-between gap-3">
            <h2 class="text-[18px] leading-[1.4] font-semibold text-verde-escuro" id="titulo-atividades"></h2>
            <a id="editar-atividades" hidden href={url("/editar-atividades")} class="inline-flex items-center gap-2 text-[15px] font-bold text-verde-medio hover:underline"><span data-ico="lapis"></span>Editar atividades</a>
          </div>
          <ul id="atividades" class="mt-4 space-y-2.5"></ul>
        </section>

        <section class="rounded-cartao border border-borda bg-white p-6 shadow-[0_1px_3px_rgba(15,41,8,0.08)]">
          <h2 class="text-[18px] leading-[1.4] font-semibold text-verde-escuro">Histórico da inscrição</h2>
          <ul id="historico" class="mt-4 space-y-3"></ul>
        </section>
      </div>

      <aside class="flex flex-col gap-5" id="lateral"></aside>
    </div>
  </div>
  <p id="erro-carga" role="alert" hidden class="mx-auto w-full max-w-[1120px] rounded-campo border border-erro-borda bg-erro-fundo p-4 text-erro"></p>

  <!-- Cancelar inscrição · confirmação -->
  <div id="cancelar" hidden class="fixed inset-0 z-50 flex items-center justify-center p-4">
    <div data-fechar-cancelar class="absolute inset-0 bg-verde-noite/60"></div>
    <div role="alertdialog" aria-modal="true" aria-labelledby="cancelar-titulo" class="relative w-full max-w-[440px] rounded-cartao bg-white p-6 shadow-2xl">
      <div class="flex items-center gap-3">
        <span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-erro-fundo text-erro"><TriangleAlert class="size-5" aria-hidden="true" /></span>
        <h2 id="cancelar-titulo" class="text-[18px] leading-[1.4] font-semibold text-verde-escuro">Cancelar inscrição?</h2>
      </div>
      <p id="cancelar-texto" class="mt-4 text-[15px] leading-normal text-chumbo"></p>
      <p id="cancelar-erro" role="alert" hidden class="mt-3 text-[13px] text-erro"></p>
      <div class="mt-5 flex justify-end gap-3">
        <button type="button" data-fechar-cancelar class="cursor-pointer rounded-full border-2 border-verde-escuro bg-white px-4 py-2.5 text-sm font-bold text-verde-escuro hover:bg-palha">Manter inscrição</button>
        <button type="button" id="confirmar-cancelamento" class="cursor-pointer rounded-full bg-erro px-4 py-2.5 text-sm font-bold text-white hover:brightness-110 disabled:opacity-60">Sim, cancelar inscrição</button>
      </div>
    </div>
  </div>
  <IconesCliente />
</Base>

<script>
  import { api, exigirLogin, formatarData, formatarDataHora, formatarMoeda, type Inscricao, type Pagamento } from "../lib/api";
  import { url } from "../lib/url";
  import { aviso, formaParticipacao, gradeDados, historico, ico, linhaAtividade, selo, seloEmail, seloInscricao, type ItemCatalogo } from "../lib/visao";

  const sessao = exigirLogin();
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const catalogo = new Map((JSON.parse($("#catalogo").textContent!) as ItemCatalogo[]).map((a) => [a.slug, a]));
  let insc: Inscricao;
  let cfg: Pagamento;

  document.querySelectorAll("[data-ico]").forEach((el) => (el.innerHTML = ico((el as HTMLElement).dataset.ico!, "size-[18px]")));

  const quando = (iso: string | null) => formatarDataHora(iso).replace(", ", " às ").replace(":", "h");
  const dia = (iso: string | null) => (iso ? formatarData(iso) : null);
  const alerta = (cor: "info" | "aviso" | "sucesso", titulo: string, texto: string) => {
    const c = { info: ["border-info-borda bg-info-fundo", "text-info-texto", "info"], aviso: ["border-pendente-borda bg-pendente-fundo", "text-pendente-texto", "alerta"], sucesso: ["border-entregue-borda bg-entregue-fundo", "text-entregue-texto", "circulo-ok"] }[cor];
    return `<div class="flex items-start gap-3 rounded-campo border p-4 ${c[0]}"><span class="mt-0.5 ${c[1]}">${ico(c[2], "size-5")}</span><div><p class="text-sm leading-[1.4] font-semibold ${c[1]}">${titulo}</p><p class="text-[15px] leading-normal text-chumbo">${texto}</p></div></div>`;
  };

  function cartaoSituacao(): string {
    const base = "rounded-cartao border p-5";
    const linha = (fundo: string, icone: string, cor: string, titulo: string, seloHtml: string, texto: string) =>
      `<section class="${base} ${fundo}"><div class="flex items-center gap-3"><span class="flex size-10 shrink-0 items-center justify-center rounded-full bg-white ${cor}">${ico(icone, "size-5")}</span><div><h2 class="text-[18px] leading-[1.4] font-semibold text-verde-escuro">${titulo}</h2>${seloHtml}</div></div><p class="mt-3 text-[15px] leading-normal text-chumbo">${texto}</p></section>`;
    if (insc.status === "cancelada" && insc.devolucao) {
      const feita = insc.devolucao.situacao === "devolvido";
      return (
        linha(feita ? "border-entregue-borda bg-entregue-fundo" : "border-pendente-borda bg-pendente-fundo", "desfazer", feita ? "text-entregue-texto" : "text-pendente-texto", "Devolução do pagamento",
          feita ? selo("verde", "circulo-ok", "Devolvido") : selo("ambar", "desfazer", "Devolução pendente"),
          feita ? "A organização registrou a devolução do valor pago." : "Sua inscrição foi cancelada. A devolução do valor pago está pendente e será realizada pelo responsável pelo evento.") +
        `<p class="text-[13px] leading-normal text-texto-suave">Valor a devolver: ${formatarMoeda(insc.devolucao.valor ?? 0)}. A devolução é realizada pelo responsável pelo evento; o sistema registra e acompanha a situação.</p>`
      );
    }
    if (insc.status === "cancelada")
      return `<section class="${base} border-borda bg-white"><h2 class="text-[18px] leading-[1.4] font-semibold text-verde-escuro">Pagamento ou compensação</h2><div class="mt-2">${selo("cinza", "proibido", "Não se aplica")}</div><p class="mt-3 text-[13px] leading-normal text-texto-suave">A inscrição foi cancelada. Não há compensação a entregar nem valor a devolver.</p></section>`;
    return insc.situacaoPagamento === "regularizada"
      ? linha("border-entregue-borda bg-entregue-fundo", "circulo-ok", "text-verde-escuro", "Pagamento ou compensação", selo("verde", "circulo-ok", "Regularizada"), "A organização registrou o cumprimento da forma de participação.")
      : linha("border-pendente-borda bg-pendente-fundo", "carteira", "text-pendente-texto", "Pagamento ou compensação", selo("ambar", "relogio", "Pendente"), "A organização ainda não registrou o cumprimento da forma de participação.");
  }

  function cartaoPrazos(): string {
    const alterar = dia(cfg.prazoAlteracao);
    const cancelar = dia(cfg.prazoCancelamento);
    const encerrado = insc.status === "confirmada" && !insc.podeAlterarAtividades && !insc.podeCancelar;
    let rodape = "";
    if (insc.status === "cancelada") rodape = `<p class="mt-3 text-[13px] leading-normal text-texto-suave">Inscrição cancelada. Sua conta continua ativa e o histórico foi mantido.</p>`;
    else if (insc.podeCancelar)
      rodape = `<button type="button" id="abrir-cancelar" class="mt-4 flex w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-erro px-5 py-3 text-[15px] leading-[1.3] font-bold text-white hover:brightness-110">${ico("proibido", "size-[18px]")}Cancelar inscrição</button>`;
    else if (encerrado) rodape = `<div class="mt-3">${selo("cinza", "relogio", "Prazo encerrado")}</div>`;
    return `<section class="rounded-cartao border border-borda bg-white p-5"><h2 class="text-[18px] leading-[1.4] font-semibold text-verde-escuro">Prazos</h2>
      <p class="mt-3 flex items-center gap-2 text-[13px] leading-normal text-chumbo"><span class="text-verde-medio">${ico("lapis", "size-4")}</span>Alterar dados e atividades ${alterar ? `até ${alterar}` : "— sem prazo definido"}</p>
      <p class="mt-2 flex items-center gap-2 text-[13px] leading-normal text-chumbo"><span class="text-verde-medio">${ico("proibido", "size-4")}</span>Cancelar inscrição ${cancelar ? `até ${cancelar}` : "— sem prazo definido"}</p>${rodape}</section>`;
  }

  function desenhar() {
    const cancelada = insc.status === "cancelada";
    $("#resumo").innerHTML = `${seloInscricao(insc.status)}<span>Inscrição nº ${insc.numero ?? "—"} · confirmada em ${dia(insc.confirmadaEm)} · conta ${sessao!.usuario.login}</span>`;

    const devolucao = insc.devolucao;
    const encerrado = insc.status === "confirmada" && !insc.podeAlterarAtividades && !insc.podeCancelar;
    $("#aviso-topo").innerHTML = cancelada
      ? devolucao
        ? alerta(devolucao.situacao === "devolvido" ? "sucesso" : "aviso", devolucao.situacao === "devolvido" ? "Inscrição cancelada · devolução concluída" : "Inscrição cancelada · devolução pendente",
            `Sua inscrição foi cancelada em ${dia(insc.canceladaEm)}. Sua conta e o histórico foram mantidos. ${devolucao.situacao === "devolvido" ? `A devolução de ${formatarMoeda(devolucao.valor ?? 0)} foi registrada como concluída.` : `A devolução de ${formatarMoeda(devolucao.valor ?? 0)} está pendente.`}`)
        : alerta("info", `Inscrição cancelada em ${dia(insc.canceladaEm)}`, "Sua conta continua ativa e o histórico da inscrição foi mantido. As vagas das atividades foram liberadas.")
      : encerrado
        ? alerta("aviso", "Prazo de alterações encerrado", `O prazo para editar dados, alterar atividades e cancelar a inscrição terminou em ${dia(cfg.prazoAlteracao ?? cfg.prazoCancelamento)}. Em caso de dúvida, fale com a organização.`)
        : "";

    $("#dados").innerHTML = gradeDados(insc.dados);
    $("#selo-email").innerHTML = seloEmail(insc.emailVerificado);
    $("#reenviar").hidden = insc.emailVerificado || cancelada;
    $("#editar-dados").hidden = !insc.podeEditar || encerrado;
    $("#editar-atividades").hidden = !insc.podeAlterarAtividades;

    const slugs = insc.atividades.filter((s) => catalogo.has(s));
    $("#titulo-atividades").textContent = `${cancelada ? "Atividades da inscrição cancelada" : "Atividades selecionadas"} (${slugs.length})`;
    $("#atividades").innerHTML = slugs.map((s) => linhaAtividade(catalogo.get(s)!)).join("");
    $("#historico").innerHTML = historico(insc);
    $("#lateral").innerHTML = cartaoSituacao() + formaParticipacao(insc.pagamento ?? cfg) + cartaoPrazos();
    $("#conteudo").hidden = false;
  }

  // ---- cancelamento ----
  const dialogo = $("#cancelar");
  const abrirDialogo = () => {
    const monetariaPaga = insc.pagamento?.modalidade === "monetaria" && insc.situacaoPagamento === "regularizada";
    $("#cancelar-texto").textContent = `A inscrição nº ${insc.numero ?? "—"} será cancelada e suas vagas nas atividades serão liberadas. Sua conta e o histórico da inscrição serão mantidos.${monetariaPaga ? ` Como o pagamento de ${formatarMoeda(insc.pagamento!.valor ?? 0)} já foi regularizado, será registrada uma pendência de devolução.` : ""}`;
    $("#cancelar-erro").hidden = true;
    dialogo.hidden = false;
    dialogo.querySelector<HTMLElement>("button")!.focus();
  };
  const fecharDialogo = () => (dialogo.hidden = true);
  document.addEventListener("click", (e) => {
    const alvo = e.target as HTMLElement;
    if (alvo.closest("#abrir-cancelar")) abrirDialogo();
    if (alvo.closest("[data-fechar-cancelar]")) fecharDialogo();
  });
  document.addEventListener("keydown", (e) => e.key === "Escape" && fecharDialogo());
  $("#confirmar-cancelamento").addEventListener("click", async () => {
    const botao = $<HTMLButtonElement>("#confirmar-cancelamento");
    botao.disabled = true;
    try {
      insc = (await api<{ inscricao: Inscricao }>("/inscricao/cancelar", { metodo: "POST" })).inscricao;
      fecharDialogo();
      desenhar();
      aviso(insc.devolucao ? "Inscrição cancelada. Devolução registrada como pendente." : "Inscrição cancelada.");
      scrollTo({ top: 0 });
    } catch (e) {
      const erro = $("#cancelar-erro");
      erro.textContent = e instanceof Error ? e.message : "Não foi possível cancelar.";
      erro.hidden = false;
    } finally {
      botao.disabled = false;
    }
  });

  $("#reenviar").addEventListener("click", async () => {
    const status = $("#reenvio-status");
    try {
      await api("/inscricao/reenviar-verificacao", { metodo: "POST" });
      status.textContent = "Solicitamos o reenvio do e-mail de verificação.";
    } catch (e) {
      status.textContent = e instanceof Error ? e.message : "Não foi possível reenviar.";
    }
  });

  async function iniciar() {
    if (!sessao) return;
    try {
      [cfg, insc] = await Promise.all([api<Pagamento>("/pagamento", { auth: false }), api<{ inscricao: Inscricao }>("/inscricao").then((r) => r.inscricao)]);
      if (insc.status === "rascunho") return void (location.href = url("/inscricao"));
      desenhar();
      const flash = sessionStorage.getItem("semana:aviso");
      if (flash) {
        sessionStorage.removeItem("semana:aviso");
        aviso(flash);
      }
    } catch (e) {
      const erro = $("#erro-carga");
      erro.textContent = e instanceof Error ? e.message : "Não foi possível carregar a inscrição.";
      erro.hidden = false;
    }
  }
  void iniciar();
</script>
