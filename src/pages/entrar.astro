---
import { KeyRound, LogIn, UserPlus } from "@lucide/astro";
import { url } from "../lib/url";
import Alerta from "../components/Alerta.astro";
import Campo from "../components/Campo.astro";
import CartaoAcesso from "../components/CartaoAcesso.astro";

const botao = "flex w-full cursor-pointer items-center justify-center gap-2 rounded-full bg-verde-cta px-[22px] py-3 text-[15px] leading-[1.3] font-bold text-verde-noite hover:brightness-95 disabled:opacity-60";
const link = "flex items-center gap-2 rounded-full px-2 py-3 text-[15px] font-bold text-verde-medio hover:underline";
---

<CartaoAcesso titulo="Entrar" ativo="/entrar">
  <LogIn slot="icone" class="size-8" aria-hidden="true" />
  <form id="form" novalidate class="flex w-full flex-col gap-4">
    <Alerta tipo="erro" titulo="Não foi possível entrar" geral />
    <Alerta tipo="aviso" titulo="Entre para continuar" class="hidden" id="aviso-restrito">Esta área é exclusiva para participantes autenticados.</Alerta>
    <p class="text-center text-[15px] leading-normal text-chumbo">Use o e-mail e a senha da sua conta.</p>
    <Campo nome="login" rotulo="E-mail" tipo="email" icone="email" placeholder="nome@exemplo.com" autocomplete="username" inputmode="email" maxlength={120} />
    <Campo nome="senha" rotulo="Senha" tipo="password" icone="cadeado" placeholder="Digite sua senha" autocomplete="current-password" />
    <button type="submit" class={botao}>
      <LogIn class="size-[18px]" aria-hidden="true" />
      Entrar
    </button>
    <a href={url("/cadastro")} class="flex w-full items-center justify-center gap-2 rounded-full border-2 border-verde-escuro bg-white px-[22px] py-2.5 text-[15px] leading-[1.3] font-bold text-verde-escuro hover:bg-palha">
      <UserPlus class="size-[18px]" aria-hidden="true" />
      Criar conta
    </a>
    <a href={url("/recuperar-senha")} class:list={[link, "justify-center"]}>
      <KeyRound class="size-[18px]" aria-hidden="true" />
      Esqueci minha senha
    </a>
  </form>
</CartaoAcesso>

<script>
  import { api, ApiError, destinoSeguro, erroCampos, limparErro, mostrarErro, salvarSessao, type Sessao } from "../lib/api";
  const form = document.querySelector<HTMLFormElement>("#form")!;
  const params = new URLSearchParams(location.search);
  // Redirecionado de uma área restrita: mostra o aviso do protótipo.
  if (params.get("voltar")) document.getElementById("aviso-restrito")!.classList.remove("hidden");

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    limparErro(form);
    const d = Object.fromEntries(new FormData(form)) as Record<string, string>;
    const campos: Record<string, string> = {};
    if (!d.login?.trim()) campos.login = "Informe o seu e-mail.";
    if (!d.senha) campos.senha = "Informe a sua senha.";
    if (Object.keys(campos).length) return mostrarErro(form, erroCampos(campos));
    const botao = form.querySelector<HTMLButtonElement>("button[type=submit]")!;
    botao.disabled = true;
    try {
      const r = await api<Sessao>("/login", { metodo: "POST", corpo: { login: d.login.trim().toLowerCase(), senha: d.senha }, auth: false });
      salvarSessao({ token: r.token, expiraEm: r.expiraEm, usuario: r.usuario });
      const padrao = r.usuario.papel === "admin" ? "/admin" : "/minha-area";
      location.href = destinoSeguro(params.get("voltar"), padrao);
    } catch (err) {
      mostrarErro(form, err instanceof ApiError && err.status === 401 ? erroCampos({}, "E-mail ou senha inválidos. Verifique os dados e tente novamente.") : err);
      botao.disabled = false;
    }
  });
</script>
