---
import { url } from "../lib/url";
import { ChevronLeft, MapPin } from "@lucide/astro";
import DetalheAtividade from "../components/DetalheAtividade.astro";
import PaginaCabecalho from "../components/PaginaCabecalho.astro";
import TagTipo from "../components/TagTipo.astro";
import Base from "../layouts/Base.astro";
import { atividadesListadas, dias, type TipoAtividade } from "../data/evento";

/* Página única de atividades (RN-04): filtro por tipo e atividade selecionada via ?atividade=slug ou #slug (RN-06). */
const conta = (tipos: TipoAtividade[]) => atividadesListadas.filter((a) => tipos.includes(a.tipo)).length;
const filtros: { id: string; rotulo: string; tipos: TipoAtividade[] }[] = [
  { id: "todas", rotulo: "Todas", tipos: [] },
  { id: "minicurso", rotulo: "Minicursos", tipos: ["minicurso"] },
  { id: "palestra", rotulo: "Palestras", tipos: ["palestra", "mesa-redonda"] },
  { id: "curso", rotulo: "Cursos", tipos: ["curso"] },
  { id: "banner", rotulo: "Exposição de Banners", tipos: ["banner"] },
  { id: "artigo", rotulo: "Apresentação de artigos", tipos: ["artigo"] },
];
const filtroDe = (tipo: TipoAtividade) => filtros.find((f) => f.tipos.includes(tipo))!.id;
const total = (f: (typeof filtros)[number]) => (f.id === "todas" ? atividadesListadas.length : conta(f.tipos));
const dataCurta = (id: string) => id.replace("-", "/");
---

<Base titulo="Atividades" ativo="/atividades" espaco="amplo">
  <div class="flex flex-col gap-5">
    <PaginaCabecalho
      simples
      titulo="Atividades"
      descricao="Todas as atividades da Semana Acadêmica reunidas em uma única página: minicursos, palestras, cursos, exposição de banners e apresentação de artigos."
    />

    <a data-voltar hidden href={url("/cronograma")} class="-mt-2 flex w-fit items-center gap-1 text-sm font-semibold text-verde-medio hover:underline">
      <ChevronLeft class="size-4" aria-hidden="true" />
      Voltar para o Cronograma
    </a>

    <div role="group" aria-label="Filtrar por tipo" class="flex flex-wrap gap-2">
      {
        filtros.map((f) => (
          <button
            type="button"
            data-filtro={f.id}
            aria-pressed={f.id === "todas" ? "true" : "false"}
            class="cursor-pointer rounded-full border border-verde-claro bg-white px-3.5 py-1.5 text-sm leading-[1.4] font-semibold text-verde-escuro aria-pressed:border-verde-escuro aria-pressed:bg-verde-escuro aria-pressed:text-white"
          >
            {f.rotulo} ({total(f)})
          </button>
        ))
      }
    </div>

    <div class="grid items-start gap-6 lg:grid-cols-[560px_1fr]">
      <div class="flex flex-col gap-2.5">
        {
          dias.map((dia) => (
            <section data-dia class="flex flex-col gap-2.5">
              <h2 class="text-lg leading-[1.4] font-semibold text-verde-escuro">{dia.data}</h2>
              {atividadesListadas
                .filter((a) => a.dia === dia.id)
                .map((a) => (
                  <div data-item={a.slug} data-tipo={filtroDe(a.tipo)} class="flex flex-col gap-2.5">
                    <button
                      type="button"
                      data-abrir={a.slug}
                      class="flex w-full cursor-pointer items-start gap-3.5 rounded-campo border border-borda bg-white px-4 py-3.5 text-left hover:bg-palha aria-[current=true]:border-2 aria-[current=true]:border-verde-medio aria-[current=true]:bg-entregue-fundo"
                    >
                      <span class="flex w-16 shrink-0 flex-col">
                        <span class="text-sm leading-[1.4] font-semibold text-verde-escuro">{dataCurta(dia.id)}</span>
                        <span class="text-[13px] leading-normal text-texto-suave">{a.hora}</span>
                      </span>
                      <span class="flex min-w-0 flex-1 flex-col gap-1">
                        <TagTipo tipo={a.tipo} />
                        <span class="text-sm leading-[1.4] font-semibold text-verde-escuro">{a.titulo}</span>
                        <span class="flex items-center gap-1.5 text-[13px] leading-normal text-texto-suave">
                          <MapPin class="size-3.5 shrink-0" aria-hidden="true" />
                          {a.local}
                        </span>
                      </span>
                      <span data-selecionada hidden class="shrink-0 text-xs leading-[1.3] font-bold tracking-[0.4px] text-verde-escuro uppercase">Selecionada</span>
                    </button>
                    <div data-detalhe-movel={a.slug} hidden class="lg:hidden">
                      <DetalheAtividade atividade={a} />
                    </div>
                  </div>
                ))}
            </section>
          ))
        }
      </div>

      <div class="hidden lg:sticky lg:top-4 lg:block">
        {
          atividadesListadas.map((a) => (
            <div data-detalhe={a.slug} hidden>
              <DetalheAtividade atividade={a} />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</Base>

<script>
  const itens = [...document.querySelectorAll<HTMLElement>("[data-item]")];
  const botoes = [...document.querySelectorAll<HTMLButtonElement>("[data-abrir]")];
  const filtros = [...document.querySelectorAll<HTMLButtonElement>("[data-filtro]")];
  const desktop = window.matchMedia("(min-width: 1024px)");

  const selecionar = (slug: string, rolar = false) => {
    botoes.forEach((b) => {
      const ativo = b.dataset.abrir === slug;
      b.setAttribute("aria-current", String(ativo));
      b.querySelector<HTMLElement>("[data-selecionada]")!.hidden = !ativo;
    });
    document.querySelectorAll<HTMLElement>("[data-detalhe]").forEach((d) => (d.hidden = d.dataset.detalhe !== slug));
    document.querySelectorAll<HTMLElement>("[data-detalhe-movel]").forEach((d) => (d.hidden = d.dataset.detalheMovel !== slug));
    history.replaceState(null, "", `?atividade=${slug}`);
    if (rolar && !desktop.matches) botoes.find((b) => b.dataset.abrir === slug)!.scrollIntoView({ block: "start" });
  };

  const filtrar = (id: string) => {
    filtros.forEach((f) => f.setAttribute("aria-pressed", String(f.dataset.filtro === id)));
    itens.forEach((i) => (i.hidden = id !== "todas" && i.dataset.tipo !== id));
    document.querySelectorAll<HTMLElement>("[data-dia]").forEach((d) => (d.hidden = ![...d.querySelectorAll<HTMLElement>("[data-item]")].some((i) => !i.hidden)));
  };

  botoes.forEach((b) => b.addEventListener("click", () => selecionar(b.dataset.abrir!, true)));
  filtros.forEach((f) =>
    f.addEventListener("click", () => {
      filtrar(f.dataset.filtro!);
      const primeiro = itens.find((i) => !i.hidden);
      if (primeiro && !itens.some((i) => !i.hidden && i.querySelector("[aria-current=true]"))) selecionar(primeiro.dataset.item!);
    }),
  );

  const params = new URLSearchParams(location.search);
  const slug = params.get("atividade") ?? decodeURIComponent(location.hash.slice(1));
  const alvo = itens.find((i) => i.dataset.item === slug);
  if (alvo) filtrar("todas");
  selecionar((alvo ?? itens[0]).dataset.item!, Boolean(alvo));
  if (params.get("de") === "cronograma") document.querySelector<HTMLElement>("[data-voltar]")!.hidden = false;
</script>
