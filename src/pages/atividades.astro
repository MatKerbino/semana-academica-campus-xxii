---
import { url } from "../lib/url";
import { ChevronLeft } from "@lucide/astro";
import IconesCliente from "../components/IconesCliente.astro";
import PaginaCabecalho from "../components/PaginaCabecalho.astro";
import Base from "../layouts/Base.astro";
---

<Base titulo="Atividades" ativo="/atividades" espaco="amplo">
  <div class="flex flex-col gap-5">
    <PaginaCabecalho
      titulo="Atividades"
      descricao="Todas as atividades da {{nome}} reunidas em uma única página: minicursos, palestras, cursos, exposição de banners e apresentação de artigos."
    />

    <a data-voltar hidden href={url("/cronograma")} class="-mt-2 flex w-fit items-center gap-1 text-sm font-semibold text-verde-medio hover:underline">
      <ChevronLeft class="size-4" aria-hidden="true" />
      Voltar para o Cronograma
    </a>

    <div data-filtros role="group" aria-label="Filtrar por tipo" class="flex flex-wrap gap-2"></div>

    <div class="grid items-start gap-6 lg:grid-cols-[560px_1fr]">
      <div data-lista class="flex flex-col gap-2.5"></div>
      <div data-detalhe class="hidden lg:sticky lg:top-4 lg:block"></div>
    </div>
  </div>
  <IconesCliente />
</Base>

<script>
  import { iniciarAtividades } from "../lib/paginas/atividades";

  iniciarAtividades();
</script>
