---
import PaginaListagem from "../components/PaginaListagem.astro";
import { porTipo } from "../data/evento";
---

<PaginaListagem
  titulo="Cursos"
  descricao="Cursos de extensão de 8 horas, em dois encontros, com certificado emitido pela UEPA."
  ativo="/cursos"
  grupos={[{ id: "lista", rotulo: "Cursos de extensão", atividades: porTipo("curso") }]}
  notasRotulo="Certificação e requisitos"
  notas={[
    "Frequência mínima de 75% da carga horária para emissão do certificado.",
    "Os certificados são enviados por e-mail em até 30 dias após o encerramento do evento.",
    "As vagas são confirmadas por ordem de recebimento das inscrições por e-mail.",
    "Não há pré-requisito de vínculo com a UEPA: os cursos são abertos à comunidade externa.",
  ]}
/>
