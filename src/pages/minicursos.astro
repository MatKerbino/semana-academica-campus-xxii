---
import PaginaListagem from "../components/PaginaListagem.astro";
import { porTipo } from "../data/evento";
---

<PaginaListagem
  titulo="Minicursos"
  descricao="Minicursos práticos de 3 horas, com vagas limitadas e certificado de carga horária."
  ativo="/minicursos"
  grupos={[{ id: "lista", rotulo: "Minicursos", atividades: porTipo("minicurso") }]}
  notasRotulo="Orientações e vagas"
  notas={[
    "As vagas são limitadas e confirmadas por e-mail, por ordem de recebimento das inscrições.",
    "Os laboratórios já possuem o ambiente configurado; o uso de notebook próprio é opcional.",
    "O certificado de 3 horas é emitido para quem cumprir a frequência integral do minicurso.",
    "Chegue 15 minutos antes do início para o credenciamento na sala da atividade.",
  ]}
/>
