---
import IconesCliente from "../components/IconesCliente.astro";
import CabecalhoInscricao from "../components/inscricao/CabecalhoInscricao.astro";
import Confirmada from "../components/inscricao/Confirmada.astro";
import EtapaAtividades from "../components/inscricao/EtapaAtividades.astro";
import EtapaDados from "../components/inscricao/EtapaDados.astro";
import EtapaRevisao from "../components/inscricao/EtapaRevisao.astro";
import PainelPolitica from "../components/inscricao/PainelPolitica.astro";
import Base from "../layouts/Base.astro";
import { catalogoSelecionavel } from "../data/evento";
---

<Base titulo="Inscrição" espaco="acesso">
  <script type="application/json" id="catalogo" set:html={JSON.stringify(catalogoSelecionavel)} />

  <div id="conteudo" hidden class="mx-auto flex w-full max-w-[1120px] flex-col gap-5">
    <CabecalhoInscricao />
    <EtapaDados />
    <EtapaAtividades />
    <EtapaRevisao />
    <Confirmada />
  </div>

  <p id="erro-carga" role="alert" hidden class="mx-auto w-full max-w-[1120px] rounded-campo border border-erro-borda bg-erro-fundo p-4 text-erro"></p>

  <PainelPolitica />
  <IconesCliente />
</Base>

<script>
  import { iniciarInscricao } from "../lib/inscricao";

  iniciarInscricao();
</script>
