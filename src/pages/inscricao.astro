---
import { ArrowLeft, Clock, FileText, UserRound, X } from "@lucide/astro";
import Alerta from "../components/Alerta.astro";
import CamposDados from "../components/CamposDados.astro";
import IconesCliente from "../components/IconesCliente.astro";
import PoliticaTexto from "../components/PoliticaTexto.astro";
import PaginaCabecalho from "../components/PaginaCabecalho.astro";
import Base from "../layouts/Base.astro";
import { catalogoSelecionavel } from "../data/evento";
import { url } from "../lib/url";

const cartao = "rounded-cartao border border-borda bg-white p-6 shadow-[0_1px_3px_rgba(15,41,8,0.08)]";
const btnPrimario = "inline-flex cursor-pointer items-center justify-center gap-2 rounded-full bg-verde-cta px-[22px] py-3 text-[15px] leading-[1.3] font-bold text-verde-noite hover:brightness-95 disabled:cursor-not-allowed disabled:opacity-60";
const btnContorno = "inline-flex cursor-pointer items-center justify-center gap-2 rounded-full border-2 border-verde-escuro bg-white px-[22px] py-2.5 text-[15px] leading-[1.3] font-bold text-verde-escuro hover:bg-palha";
const btnTexto = "inline-flex cursor-pointer items-center gap-2 py-2 text-[15px] leading-[1.3] font-bold text-verde-medio hover:underline";
---

<Base titulo="Inscrição" espaco="acesso">
  <script type="application/json" id="catalogo" set:html={JSON.stringify(catalogoSelecionavel)} />

  <div id="conteudo" hidden class="mx-auto flex w-full max-w-[1120px] flex-col gap-5">
    <div id="cabecalho">
      <PaginaCabecalho titulo="Inscrição na 1ª Semana Acadêmica" trilha={[{ href: "/", rotulo: "Início" }, { href: "/minha-area", rotulo: "Minha área" }]}>
        <p class="mt-1.5 flex items-center gap-2 text-[13px] leading-normal text-chumbo">
          <UserRound class="size-4 text-verde-medio" aria-hidden="true" />
          <span>Inscrição vinculada à conta <span data-login></span></span>
        </p>
        <div id="passos" class="mt-3"></div>
      </PaginaCabecalho>
    </div>

    <!-- Etapa 1 · Dados e política -->
    <form id="etapa-1" novalidate hidden class="flex flex-col gap-5">
      <section class={`${cartao} flex flex-col gap-4 md:flex-row md:items-center md:gap-8`}>
        <div data-forma class="w-full md:w-auto"></div>
        <p class="text-[13px] leading-normal text-texto-suave md:max-w-[520px]">A forma de participação é definida pela organização e vale para todos os inscritos. Ela será confirmada na revisão.</p>
      </section>

      <Alerta tipo="erro" titulo="Corrija os campos destacados" geral />

      <section class={`${cartao} flex flex-col gap-4`}>
        <div>
          <h2 class="text-[18px] leading-[1.4] font-semibold text-verde-escuro">Dados pessoais</h2>
          <p class="mt-2 text-[13px] leading-normal text-texto-suave">Campos com * são obrigatórios. Estes dados ficam associados à sua conta de acesso e não criam uma nova conta.</p>
        </div>
        <CamposDados />
      </section>

      <section class={`${cartao} flex flex-col gap-3`}>
        <h2 class="text-[18px] leading-[1.4] font-semibold text-verde-escuro">Política de Privacidade</h2>
        <p class="text-[15px] leading-normal text-chumbo">Antes de concluir a inscrição, leia como seus dados serão tratados pela comissão organizadora.</p>
        <button type="button" id="abrir-politica" class={`${btnTexto} self-start`}>
          <FileText class="size-[18px]" aria-hidden="true" />
          Ler a Política de Privacidade
        </button>
        <div>
          <label class="inline-flex cursor-pointer items-center gap-2.5 text-[15px] text-chumbo">
            <input type="checkbox" name="aceitePrivacidade" class="size-[18px] cursor-pointer rounded border-[1.5px] border-chumbo/60 accent-verde-medio aria-[invalid=true]:border-erro aria-[invalid=true]:border-2" />
            Li e aceito a Política de Privacidade *
          </label>
          <p data-erro="aceitePrivacidade" class="mt-1 text-[13px] leading-normal text-erro empty:hidden"></p>
        </div>
      </section>

      <div class="flex flex-wrap items-center justify-between gap-3">
        <button type="button" data-salvar-depois class={`${btnTexto} order-2 w-full justify-center sm:order-1 sm:w-auto`}>
          <Clock class="size-[18px]" aria-hidden="true" />
          Salvar e continuar depois
        </button>
        <button type="submit" class={`${btnPrimario} order-1 w-full sm:order-2 sm:w-auto`}>Continuar para atividades</button>
      </div>
    </form>

    <!-- Etapa 2 · Atividades -->
    <div id="etapa-2" hidden class="flex flex-col gap-5">
      <Alerta tipo="info" titulo="Escolha suas atividades">
        Selecione as atividades de que deseja participar. Atividades sem vagas não podem ser selecionadas. Credenciamento, abertura e premiação fazem parte da programação geral e não precisam de seleção.
      </Alerta>
      <Alerta tipo="erro" titulo="Não foi possível continuar" geral id="erro-etapa-2" />
      <div id="seletor" class="flex flex-col gap-5"></div>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <button type="button" data-salvar-depois class={`${btnTexto} order-3 w-full justify-center sm:order-1 sm:w-auto`}>
          <Clock class="size-[18px]" aria-hidden="true" />
          Salvar e continuar depois
        </button>
        <div class="order-1 flex w-full flex-col gap-3 sm:order-2 sm:w-auto sm:flex-row">
          <button type="button" data-ir="1" class={btnContorno}>
            <ArrowLeft class="size-[18px]" aria-hidden="true" />
            Voltar para dados
          </button>
          <button type="button" data-ir="3" class={btnPrimario}>Continuar para revisão</button>
        </div>
      </div>
    </div>

    <!-- Etapa 3 · Revisão e confirmação -->
    <div id="etapa-3" hidden class="flex flex-col gap-5">
      <div id="alerta-revisao"></div>
      <section class={cartao}>
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-[18px] leading-[1.4] font-semibold text-verde-escuro">Dados da inscrição</h2>
          <button type="button" data-ir="1" class={btnTexto}><span data-ico="lapis"></span>Editar</button>
        </div>
        <div id="revisao-dados" class="mt-4"></div>
      </section>
      <section class={cartao}>
        <div class="flex items-center justify-between gap-3">
          <h2 class="text-[18px] leading-[1.4] font-semibold text-verde-escuro">Atividades selecionadas (<span data-total></span>)</h2>
          <button type="button" data-ir="2" class={btnTexto}><span data-ico="lapis"></span>Alterar atividades</button>
        </div>
        <ul id="revisao-atividades" class="mt-4 space-y-2.5"></ul>
      </section>
      <section class={cartao}>
        <h2 class="text-[18px] leading-[1.4] font-semibold text-verde-escuro">Forma de participação</h2>
        <div data-forma class="mt-4"></div>
        <p class="mt-4 text-[13px] leading-normal text-texto-suave">Definida pela organização e igual para todos os participantes. Não é possível escolher outra modalidade.</p>
      </section>
      <section class={cartao}>
        <h2 class="text-[18px] leading-[1.4] font-semibold text-verde-escuro">Política de Privacidade</h2>
        <p id="revisao-aceite" class="mt-3 flex items-center gap-2 text-[15px] text-chumbo"></p>
      </section>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <button type="button" data-salvar-depois class={`${btnTexto} order-3 w-full justify-center sm:order-1 sm:w-auto`}>
          <Clock class="size-[18px]" aria-hidden="true" />
          Salvar e continuar depois
        </button>
        <div class="order-1 flex w-full flex-col gap-3 sm:order-2 sm:w-auto sm:flex-row">
          <button type="button" data-ir="2" class={btnContorno}>
            <ArrowLeft class="size-[18px]" aria-hidden="true" />
            Voltar para atividades
          </button>
          <button type="button" id="confirmar" class={btnPrimario}></button>
        </div>
      </div>
    </div>

    <!-- Inscrição confirmada -->
    <div id="confirmada" hidden class="mx-auto flex w-full max-w-[488px] flex-col items-center gap-4 rounded-cartao border border-borda bg-white p-6 text-center shadow-[0_1px_3px_rgba(15,41,8,0.08)] sm:p-9">
      <div class="flex size-[72px] items-center justify-center rounded-full bg-verde-claro text-verde-escuro"><span data-ico="circulo-ok" data-grande></span></div>
      <h2 class="text-[32px] leading-[1.3] font-bold text-verde-escuro">Inscrição confirmada!</h2>
      <p id="confirmada-texto" class="text-[15px] leading-normal text-chumbo"></p>
      <Alerta tipo="aviso" titulo="Confirme seu e-mail" class="w-full text-left"><span id="confirmada-email"></span></Alerta>
      <Alerta tipo="info" titulo="Próximo passo" class="w-full text-left"><span id="confirmada-proximo"></span></Alerta>
      <p id="reenvio-status" role="status" hidden class="text-[13px] text-verde-medio"></p>
      <a href={url("/minha-inscricao")} class={`${btnPrimario} w-full`}><span data-ico="lista"></span>Ver minha inscrição</a>
      <button type="button" id="reenviar" class={btnTexto}><span data-ico="email"></span>Reenviar e-mail de verificação</button>
    </div>
  </div>

  <p id="erro-carga" role="alert" hidden class="mx-auto w-full max-w-[1120px] rounded-campo border border-erro-borda bg-erro-fundo p-4 text-erro"></p>

  <!-- Política de Privacidade (painel lateral) -->
  <div id="politica" hidden class="fixed inset-0 z-50">
    <div data-fechar-politica class="absolute inset-0 bg-verde-noite/60"></div>
    <aside role="dialog" aria-modal="true" aria-labelledby="politica-titulo" class="absolute top-0 right-0 flex h-full w-full max-w-[560px] flex-col gap-4 overflow-y-auto bg-white p-6 shadow-2xl">
      <div class="flex items-start justify-between gap-4">
        <h2 id="politica-titulo" class="text-[24px] leading-[1.3] font-bold text-verde-escuro">Política de Privacidade</h2>
        <button type="button" data-fechar-politica aria-label="Fechar" class="flex size-9 shrink-0 cursor-pointer items-center justify-center rounded-full bg-palha text-chumbo">
          <X class="size-[18px]" aria-hidden="true" />
        </button>
      </div>
      <PoliticaTexto />
      <button type="button" data-fechar-politica class={`${btnPrimario} w-full`}>
        <ArrowLeft class="size-[18px]" aria-hidden="true" />
        Fechar e voltar à inscrição
      </button>
    </aside>
  </div>
  <IconesCliente />
</Base>

<script>
  import { api, ApiError, erroCampos, exigirLogin, formatarDataHora, limparErro, mostrarErro, type Inscricao, type Pagamento, type Vagas } from "../lib/api";
  import { ativarMascaras, lerDados, preencherDados, validarDados } from "../lib/dados-form";
  import { montarSeletor } from "../lib/seletor";
  import { formaParticipacao, gradeDados, ico, linhaAtividade, passos, separarDescricao, type ItemCatalogo } from "../lib/visao";
  import { url } from "../lib/url";

  const sessao = exigirLogin();
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const catalogo = JSON.parse($("#catalogo").textContent!) as ItemCatalogo[];
  const porSlug = new Map(catalogo.map((a) => [a.slug, a]));
  const form = $<HTMLFormElement>("#etapa-1");
  const telas = { 1: $("#etapa-1"), 2: $("#etapa-2"), 3: $("#etapa-3") } as const;

  let insc: Inscricao;
  let pagamento: Pagamento;
  let vagas: Vagas = {};
  let seletor: ReturnType<typeof montarSeletor> | null = null;
  let etapa: 1 | 2 | 3 = 1;
  let indisponiveis: string[] = [];

  document.querySelectorAll("[data-ico]").forEach((el) => {
    el.innerHTML = ico((el as HTMLElement).dataset.ico!, el.hasAttribute("data-grande") ? "size-9" : "size-[18px]");
  });

  ativarMascaras(form);

  // ---- carga ----
  async function iniciar() {
    if (!sessao) return;
    document.querySelectorAll("[data-login]").forEach((el) => (el.textContent = sessao.usuario.login));
    try {
      [pagamento, vagas] = await Promise.all([
        api<Pagamento>("/pagamento", { auth: false }),
        api<{ atividades: Vagas }>("/atividades/vagas", { auth: false }).then((r) => r.atividades),
      ]);
      insc = await api<{ inscricao: Inscricao }>("/inscricao")
        .then((r) => r.inscricao)
        .catch(async (e) => {
          if (e instanceof ApiError && e.status === 404) return (await api<{ inscricao: Inscricao }>("/inscricao", { metodo: "POST" })).inscricao;
          throw e;
        });
      if (insc.status !== "rascunho") return void (location.href = url("/minha-inscricao"));
      preencher();
      const d = insc.dados;
      const completos = d.nome && d.cpf && d.email && d.telefone && d.dataNascimento && d.perfil && insc.aceitePrivacidade;
      irPara(!completos ? 1 : insc.atividades.length ? 3 : 2);
      $("#conteudo").hidden = false;
    } catch (e) {
      const erro = $("#erro-carga");
      erro.textContent = e instanceof Error ? e.message : "Não foi possível carregar a inscrição.";
      erro.hidden = false;
    }
  }

  function preencher() {
    preencherDados(form, insc.dados);
    (form.elements.namedItem("aceitePrivacidade") as HTMLInputElement).checked = insc.aceitePrivacidade;
    document.querySelectorAll("[data-forma]").forEach((el) => (el.innerHTML = formaParticipacao(pagamento)));
  }

  function irPara(n: 1 | 2 | 3) {
    etapa = n;
    ([1, 2, 3] as const).forEach((i) => (telas[i].hidden = i !== n));
    $("#confirmada").hidden = true;
    $("#cabecalho").hidden = false;
    $("#passos").innerHTML = passos(n);
    if (n === 2) desenharSeletor();
    if (n === 3) desenharRevisao();
    scrollTo({ top: 0 });
  }
  document.addEventListener("click", (e) => {
    const alvo = (e.target as HTMLElement).closest<HTMLElement>("[data-ir]");
    if (!alvo) return;
    const destino = Number(alvo.dataset.ir) as 1 | 2 | 3;
    void avancar(destino);
  });

  const dadosDoForm = () => ({ dados: lerDados(form), aceitePrivacidade: (form.elements.namedItem("aceitePrivacidade") as HTMLInputElement).checked });

  function validarEtapa1() {
    const { dados, aceitePrivacidade } = dadosDoForm();
    const c = validarDados(dados);
    if (!aceitePrivacidade) c.aceitePrivacidade = "O aceite da Política de Privacidade é obrigatório para concluir a inscrição.";
    return c;
  }

  async function salvar(corpo: object) {
    insc = (await api<{ inscricao: Inscricao }>("/inscricao", { metodo: "PUT", corpo })).inscricao;
  }

  async function avancar(destino: 1 | 2 | 3) {
    limparErro(form);
    try {
      if (etapa === 1 && destino > 1) {
        const campos = validarEtapa1();
        if (Object.keys(campos).length) {
          mostrarErro(form, erroCampos(campos, "Preencha os campos obrigatórios, selecione um perfil e aceite a Política de Privacidade para continuar."));
          $("#etapa-1 [data-erro-geral]").scrollIntoView({ block: "center" });
          return;
        }
        await salvar(dadosDoForm());
      }
      if (etapa === 2 && destino === 3) await salvar({ atividades: seletor!.obter() });
      else if (etapa === 2) await salvar({ atividades: seletor!.obter() });
      irPara(destino);
    } catch (e) {
      const alvo = etapa === 1 ? form : $("#etapa-2");
      mostrarErro(alvo, e);
    }
  }
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    void avancar(2);
  });

  // ---- etapa 2 ----
  function desenharSeletor() {
    limparErro($("#etapa-2"));
    seletor = montarSeletor({ raiz: $("#seletor"), catalogo, vagas, selecionadas: insc.atividades, salvas: [] });
  }

  // ---- etapa 3 ----
  function desenharRevisao() {
    const slugs = insc.atividades.filter((s) => porSlug.has(s));
    $("#revisao-dados").innerHTML = gradeDados(insc.dados);
    $("[data-total]").textContent = String(slugs.length);
    $("#revisao-atividades").innerHTML = slugs
      .map((s) => {
        const marca = indisponiveis.includes(s)
          ? `<span class="inline-flex items-center gap-1.5 rounded-full border border-borda bg-[#eeeeee] px-2.5 py-1 text-[11px] font-bold tracking-[0.4px] text-chumbo uppercase">${ico("proibido", "size-3.5")}Ficou sem vagas — remova para confirmar</span>`
          : "";
        return linhaAtividade(porSlug.get(s)!, marca);
      })
      .join("");
    $("#revisao-aceite").innerHTML = `<span class="text-verde-medio">${ico("circulo-ok", "size-[18px]")}</span>Aceite registrado nesta inscrição${insc.aceiteEm ? ` em ${formatarDataHora(insc.aceiteEm).replace(", ", " às ").replace(":", "h")}` : ""} · Política versão ${insc.versaoPolitica ?? "1.0"}`;
    const alerta = $("#alerta-revisao");
    if (indisponiveis.length) {
      const t = porSlug.get(indisponiveis[0])!.titulo;
      alerta.innerHTML = `<div role="alert" class="flex items-start gap-3 rounded-campo border border-erro-borda bg-erro-fundo p-4"><span class="mt-0.5 text-erro">${ico("circulo-x", "size-5")}</span><div><p class="text-sm leading-[1.4] font-semibold text-erro">Não foi possível confirmar a inscrição</p><p class="text-[15px] leading-normal text-chumbo">A atividade “${t}” ficou sem vagas enquanto você revisava. Remova-a ou escolha outra atividade para continuar.</p></div></div>`;
    } else {
      alerta.innerHTML = `<div class="flex items-start gap-3 rounded-campo border border-info-borda bg-info-fundo p-4"><span class="mt-0.5 text-info-texto">${ico("info", "size-5")}</span><div><p class="text-sm leading-[1.4] font-semibold text-info-texto">Revise antes de confirmar</p><p class="text-[15px] leading-normal text-chumbo">Sua inscrição só será registrada depois que você clicar em “Confirmar inscrição”. Use “Editar” ou “Voltar” para corrigir qualquer informação.</p></div></div>`;
    }
    const botao = $<HTMLButtonElement>("#confirmar");
    botao.innerHTML = indisponiveis.length ? `${ico("lapis", "size-[18px]")}Revisar atividades` : `${ico("ok", "size-[18px]")}Confirmar inscrição`;
  }

  $("#confirmar").addEventListener("click", async () => {
    if (indisponiveis.length) return irPara(2);
    const botao = $<HTMLButtonElement>("#confirmar");
    botao.disabled = true;
    try {
      insc = (await api<{ inscricao: Inscricao }>("/inscricao/confirmar", { metodo: "POST" })).inscricao;
      mostrarConfirmada();
    } catch (e) {
      vagas = await api<{ atividades: Vagas }>("/atividades/vagas", { auth: false }).then((r) => r.atividades).catch(() => vagas);
      indisponiveis = insc.atividades.filter((s) => vagas[s] && !vagas[s].disponivel);
      if (e instanceof ApiError && e.status === 400 && Object.keys(e.campos).some((c) => c !== "atividades")) {
        // dados incompletos: volta para a etapa 1 com os erros da API
        irPara(1);
        mostrarErro(form, e);
      } else if (indisponiveis.length) desenharRevisao();
      else {
        const alerta = $("#alerta-revisao");
        alerta.innerHTML = `<div role="alert" class="flex items-start gap-3 rounded-campo border border-erro-borda bg-erro-fundo p-4"><span class="mt-0.5 text-erro">${ico("circulo-x", "size-5")}</span><div><p class="text-sm leading-[1.4] font-semibold text-erro">Não foi possível confirmar a inscrição</p><p class="text-[15px] leading-normal text-chumbo">${e instanceof Error ? e.message : "Tente novamente."}</p></div></div>`;
      }
    } finally {
      botao.disabled = false;
    }
  });

  function mostrarConfirmada() {
    Object.values(telas).forEach((t) => (t.hidden = true));
    $("#cabecalho").hidden = true;
    $("#confirmada").hidden = false;
    const quando = formatarDataHora(insc.confirmadaEm).replace(", ", " às ").replace(":", "h");
    $("#confirmada-texto").textContent = `Inscrição nº ${insc.numero ?? "—"} registrada em ${quando} e vinculada à conta ${sessao!.usuario.login}.`;
    $("#confirmada-email").textContent = `Solicitamos o envio de um link de verificação para ${insc.dados.email}. Se não chegar em alguns minutos, use Reenviar.`;
    const p = insc.pagamento;
    const { destaque, detalhe } = separarDescricao(p?.descricao ?? null);
    $("#confirmada-proximo").textContent =
      p?.modalidade === "monetaria"
        ? `Sua forma de participação é o pagamento de ${p.valor?.toLocaleString("pt-BR", { style: "currency", currency: "BRL" })} por participante. ${p.descricao ?? ""} A organização atualizará a situação na sua área.`
        : `${destaque.replace(/\.$/, "")}. ${detalhe} A organização atualizará a situação na sua área.`.replace(/\s+/g, " ");
    scrollTo({ top: 0 });
  }

  $("#reenviar").addEventListener("click", async () => {
    const status = $("#reenvio-status");
    try {
      await api("/inscricao/reenviar-verificacao", { metodo: "POST" });
      status.textContent = "Solicitamos o reenvio do e-mail de verificação.";
    } catch (e) {
      status.textContent = e instanceof Error ? e.message : "Não foi possível reenviar.";
    }
    status.hidden = false;
  });

  // ---- salvar e continuar depois ----
  document.querySelectorAll("[data-salvar-depois]").forEach((b) =>
    b.addEventListener("click", async () => {
      try {
        if (etapa === 1) {
          const { dados, aceitePrivacidade } = dadosDoForm();
          const parcial = Object.fromEntries(Object.entries(dados).filter(([, v]) => v));
          await salvar({ dados: parcial, aceitePrivacidade });
        } else if (etapa === 2) await salvar({ atividades: seletor!.obter() });
        location.href = url("/minha-area");
      } catch (e) {
        mostrarErro(etapa === 1 ? form : $("#etapa-2"), e);
      }
    }),
  );

  // ---- painel da Política de Privacidade ----
  const painel = $("#politica");
  const abrir = $("#abrir-politica");
  const fechar = () => {
    painel.hidden = true;
    document.body.style.overflow = "";
    abrir.focus();
  };
  abrir.addEventListener("click", () => {
    painel.hidden = false;
    document.body.style.overflow = "hidden";
    painel.querySelector<HTMLElement>("button")!.focus();
  });
  painel.querySelectorAll("[data-fechar-politica]").forEach((el) => el.addEventListener("click", fechar));
  document.addEventListener("keydown", (e) => e.key === "Escape" && !painel.hidden && fechar());

  void iniciar();
</script>
