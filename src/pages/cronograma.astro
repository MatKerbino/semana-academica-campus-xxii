---
import { url } from "../lib/url";
import { Clock, MapPin } from "@lucide/astro";
import Abas from "../components/Abas.astro";
import PaginaCabecalho from "../components/PaginaCabecalho.astro";
import TagTipo from "../components/TagTipo.astro";
import Base from "../layouts/Base.astro";
import { atividades, dias, linkAtividade, tagsTipo } from "../data/evento";
---

<Base titulo="Cronograma" ativo="/cronograma" espaco="amplo">
  <div class="flex flex-col gap-5">
    <PaginaCabecalho
      simples
      titulo="Cronograma do evento"
      descricao="Programação completa dos quatro dias. Clique em uma atividade para abrir a página de Atividades com ela selecionada."
    />

    <Abas tamanho="grande" rotuloLista="Dias do evento" abas={dias.map((d) => ({ id: d.id, rotulo: d.rotulo }))}>
      {
        dias.map((dia) => (
          <div data-painel={dia.id}>
            <h2 class="sr-only">{dia.data}</h2>
            <ol class="overflow-hidden rounded-cartao border border-borda bg-white">
              {atividades
                .filter((a) => a.dia === dia.id)
                .map((a) => (
                  <li class="flex flex-col gap-x-5 gap-y-1.5 px-5 py-3.5 even:bg-palha md:flex-row md:items-center">
                    <span class="flex w-[90px] shrink-0 items-center gap-2 text-sm leading-[1.4] font-semibold text-verde-escuro">
                      <Clock class="size-4" aria-hidden="true" />
                      {a.hora}
                    </span>
                    <span class="flex min-w-0 flex-1 flex-col gap-1">
                      {tagsTipo[a.tipo] ? (
                        <TagTipo tipo={a.tipo} />
                      ) : (
                        <span class="text-xs leading-[1.3] font-bold tracking-[0.4px] text-texto-suave uppercase">
                          Programação geral · Não requer seleção
                        </span>
                      )}
                      <span class="text-sm leading-[1.4] font-semibold text-chumbo">{a.titulo}</span>
                      <span class="flex items-center gap-1.5 text-[13px] leading-normal text-texto-suave">
                        <MapPin class="size-3.5" aria-hidden="true" />
                        {a.local}
                      </span>
                    </span>
                    {tagsTipo[a.tipo] && (
                      <a
                        href={url(linkAtividade(a.slug, "cronograma"))}
                        class="shrink-0 text-sm leading-[1.4] font-semibold text-azul hover:underline"
                      >
                        Ver na página de atividades →
                      </a>
                    )}
                  </li>
                ))}
            </ol>
          </div>
        ))
      }
    </Abas>
  </div>
</Base>
