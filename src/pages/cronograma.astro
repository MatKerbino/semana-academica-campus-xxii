---
import PaginaCabecalho from "../components/PaginaCabecalho.astro";
import Base from "../layouts/Base.astro";
---

<Base titulo="Cronograma" ativo="/cronograma" espaco="amplo">
  <div class="flex flex-col gap-5">
    <PaginaCabecalho
      titulo="Cronograma do evento"
      descricao="Programação completa de {{periodo}}. Clique em uma atividade para abrir a página de Atividades com ela selecionada."
    />

    <div data-cronograma></div>
  </div>
</Base>

<script>
  import { iniciarCronograma } from "../lib/paginas/cronograma";

  iniciarCronograma();
</script>
