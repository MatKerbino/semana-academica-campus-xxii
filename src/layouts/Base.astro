---
import { url } from "../lib/url";
import "../styles/global.css";
import { Leaf, LogIn, Menu, UserPlus, X } from "@lucide/astro";
import BibliotecaIcones from "../components/BibliotecaIcones.astro";
import padrao from "../data/conteudo-padrao.json";
import { texto } from "../lib/conteudo/formatar";
import type { Conteudo } from "../lib/conteudo/tipos";

/* Textos de fábrica (pré-renderizados); no navegador, aplicarConteudo() troca pelos do conteúdo vigente. */
const c = padrao as unknown as Conteudo;
const evento = c.evento;
const t = (modelo: string) => texto(c, modelo);

interface Props {
  titulo: string;
  descricao?: string;
  /** Página ativa no menu, pelo href. */
  ativo?: string;
  /** "amplo": mais respiro no topo e na base, como nas telas de Início, Cronograma e Atividades. */
  espaco?: "compacto" | "amplo" | "acesso";
}

const { titulo, descricao = evento.descricao, ativo, espaco = "compacto" } = Astro.props;

const menu = [
  { href: "/", rotulo: "Início" },
  { href: "/cronograma", rotulo: "Cronograma" },
  { href: "/atividades", rotulo: "Atividades" },
  { href: "/noticias", rotulo: "Notícias" },
  { href: "/palestrantes", rotulo: "Palestrantes" },
  { href: "/artigos", rotulo: "Artigos" },
  { href: "/informacoes", rotulo: "Informações" },
  { href: "/patrocinadores", rotulo: "Patrocinadores" },
  { href: "/local", rotulo: "Local" },
];

const navRodape = [
  [
    { href: "/", rotulo: "Início" },
    { href: "/cronograma", rotulo: "Cronograma" },
    { href: "/atividades", rotulo: "Atividades" },
    { href: "/noticias", rotulo: "Notícias" },
    { href: "/local", rotulo: "Local" },
  ],
  [
    { href: "/palestrantes", rotulo: "Palestrantes" },
    { href: "/artigos", rotulo: "Artigos" },
    { href: "/informacoes", rotulo: "Informações" },
    { href: "/patrocinadores", rotulo: "Patrocinadores" },
  ],
];

const botaoEntrar =
  "flex shrink-0 items-center gap-2 whitespace-nowrap rounded-full border-[1.5px] border-white/35 px-4 py-[11px] text-sm leading-[1.3] font-bold text-white hover:border-white";
---

<html lang="pt-BR" class="aguardando" data-titulo-pagina={titulo}>
  <head>
    <meta charset="utf-8" />
    <!-- Paleta escolhida pelo admin aplicada antes da primeira pintura; o corpo só aparece quando o conteúdo carrega. -->
    <script is:inline>
      try {
        var p = JSON.parse(localStorage.getItem("semana:cores") || "null");
        if (p) for (var k in p) document.documentElement.style.setProperty("--color-" + k, p[k]);
      } catch (e) {}
      setTimeout(function () { document.documentElement.classList.remove("aguardando"); }, 5000);
    </script>
    <style is:inline>html.aguardando body { visibility: hidden; }</style>
    <noscript><style>html.aguardando body { visibility: visible; }</style></noscript>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <title>{titulo} · {t("{{nome}}")}</title>
    <meta name="description" content={descricao} />
  </head>
  <body class="flex min-h-dvh flex-col bg-palha">
    <header class="bg-verde-escuro text-white drop-shadow-[0_2px_3px_rgba(0,0,0,0.15)]">
      <div class="mx-auto flex min-h-[88px] max-w-[1440px] items-center gap-3 px-4 py-3 sm:gap-6 lg:h-auto lg:flex-wrap lg:gap-y-2 lg:px-12 lg:py-[18px]">
        <a href={url("/")} class="flex min-w-0 items-center gap-2.5 lg:max-w-[420px]">
          <span data-slot="marca" data-classe="size-[26px] text-verde-cta" class="flex"><Leaf class="size-[26px] text-verde-cta" aria-hidden="true" /></span>
          <span class="min-w-0">
            <span data-t="{{nome}}" class="block text-sm leading-[1.3] font-bold tracking-[0.6px] text-white uppercase lg:text-base">{t("{{nome}}")}</span>
            <span data-t="{{organizacao}} · {{ano}}" class="block text-[11px] leading-[1.3] font-medium tracking-[0.4px] text-verde-claro">{t("{{organizacao}} · {{ano}}")}</span>
          </span>
        </a>

        <nav aria-label="Navegação principal" class="hidden min-w-0 lg:order-3 lg:block lg:basis-full">
          <ul class="flex flex-wrap items-center justify-center gap-x-[18px] gap-y-1 text-[13px] leading-[1.3]">
            {
              menu.map((item) => (
                <li>
                  <a
                    href={url(item.href)}
                    aria-current={ativo === item.href ? "page" : undefined}
                    class:list={[
                      "hover:text-verde-cta",
                      ativo === item.href ? "font-semibold text-verde-cta" : "font-medium text-white",
                    ]}
                  >
                    {item.rotulo}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>

        <div class="ml-auto hidden items-center gap-2.5 lg:flex">
          <div data-sessao class="flex items-center gap-2.5">
            <a href={url("/entrar")} class={botaoEntrar}>
              <LogIn class="size-4" aria-hidden="true" />
              Entrar
            </a>
          </div>
          <a
            href={url("/cadastro")}
            data-inscreva
            class="flex shrink-0 items-center gap-2 whitespace-nowrap rounded-full bg-verde-cta px-[22px] py-[11px] text-sm leading-[1.3] font-bold text-verde-noite hover:brightness-95"
          >
            <UserPlus class="size-4" aria-hidden="true" />
            Inscreva-se
          </a>
        </div>

        <div class="ml-auto flex items-center gap-2 lg:hidden">
          <a
            href={url("/entrar")}
            data-entrar-icone
            aria-label="Entrar"
            class="flex size-11 items-center justify-center rounded-[10px] border-[1.5px] border-white/35"
          >
            <LogIn class="size-[18px]" aria-hidden="true" />
          </a>
          <button
            type="button"
            data-abrir-menu
            aria-label="Abrir menu"
            aria-expanded="false"
            aria-controls="menu-mobile"
            class="flex size-11 cursor-pointer items-center justify-center rounded-[10px] border-[1.5px] border-white/35"
          >
            <Menu class="size-[18px]" aria-hidden="true" />
          </button>
        </div>
      </div>
    </header>

    <BibliotecaIcones />

    <div id="menu-mobile" hidden class="fixed inset-0 z-50 overflow-y-auto bg-verde-escuro text-white lg:hidden">
      <div class="flex items-center justify-between px-4 py-8">
        <span data-t="{{nome}}" class="text-xs font-semibold tracking-[0.6px] uppercase">{t("{{nome}}")}</span>
        <button type="button" data-fechar-menu aria-label="Fechar menu" class="cursor-pointer">
          <X class="size-6" aria-hidden="true" />
        </button>
      </div>
      <nav aria-label="Navegação principal" class="px-6 py-3">
        <ul class="space-y-[22px] text-lg font-semibold">
          {
            menu.map((item) => (
              <li>
                <a href={url(item.href)} aria-current={ativo === item.href ? "page" : undefined} class:list={[ativo === item.href && "text-verde-cta"]}>
                  {item.rotulo}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="mt-10 space-y-3 px-4 pb-10">
        <a
          href={url("/cadastro")}
          data-inscreva
          class="flex items-center justify-center gap-2 rounded-full bg-verde-cta px-6 py-3 text-[15px] font-bold text-verde-noite"
        >
          <UserPlus class="size-4" aria-hidden="true" />
          Inscreva-se
        </a>
        <div data-sessao-mobile>
          <a href={url("/entrar")} class="flex items-center justify-center gap-2 rounded-full bg-white px-6 py-3 text-[15px] font-bold text-verde-escuro">
            <LogIn class="size-4" aria-hidden="true" />
            Entrar
          </a>
        </div>
      </div>
    </div>

    <main class="mx-auto w-full max-w-[1440px] flex-1 px-4 md:px-8 lg:px-16" class:list={[espaco === "amplo" ? "pt-6 pb-10" : espaco === "acesso" ? "py-8 lg:py-12" : "py-3"]}>
      <slot />
    </main>

    <footer class="bg-verde-escuro text-verde-claro">
      <div class="mx-auto max-w-[1440px] px-4 py-[14px] lg:px-12">
        <div class="hidden gap-8 lg:flex">
          <section class="flex-1">
            <h2 data-t="{{nome}}" class="text-[15px] leading-[1.3] font-bold text-white">{t("{{nome}}")}</h2>
            <p data-t="{{local}} · {{periodo}}" class="mt-0.5 text-[13px] leading-[1.3]">{t("{{local}} · {{periodo}}")}</p>
          </section>
          <nav aria-label="Navegação do rodapé" class="flex-1">
            <h2 class="text-[15px] leading-[1.3] font-bold text-white">Navegação</h2>
            {
              navRodape.map((linha) => (
                <p class="mt-0.5 text-[13px] leading-[1.3]">
                  {linha.map((item, i) => (
                    <>
                      {i > 0 && " · "}
                      <a href={url(item.href)} class="hover:text-verde-cta">{item.rotulo}</a>
                    </>
                  ))}
                </p>
              ))
            }
          </nav>
          <section class="flex-1 text-azul-claro">
            <h2 class="text-[15px] leading-[1.3] font-bold text-white">Participação</h2>
            <p class="mt-0.5 text-[13px] leading-[1.3]">Aberta à comunidade interna e externa</p>
            <p data-forma-part="rodape" class="mt-0.5 text-[13px] leading-[1.3]">Forma de participação: 1 kg de alimento não perecível</p>
            <p class="mt-0.5 text-[13px] leading-[1.3]"><a data-link="email" data-t="{{email}}" href={`mailto:${evento.email}`} class="hover:underline">{evento.email}</a></p>
          </section>
          <section class="flex-1">
            <h2 class="text-[15px] leading-[1.3] font-bold text-white">Realização</h2>
            <div data-realizacao>
              {evento.realizacao.map((orgao) => <p class="mt-0.5 text-[13px] leading-[1.3]">{orgao}</p>)}
            </div>
          </section>
        </div>

        <div class="lg:hidden">
          <p data-t="{{nome}}" class="text-[15px] leading-[1.3] font-bold text-white">{t("{{nome}}")}</p>
          <p data-t="{{periodo}}" class="mt-0.5 text-[13px] leading-[1.3]">{t("{{periodo}}")}</p>
          <p data-t="{{email}}" class="mt-0.5 text-[13px] leading-[1.3]">{evento.email}</p>
        </div>

        <hr class="mt-2.5 h-px border-0 bg-divisor" />
        <p data-t="© {{ano}} · {{nome}} — {{organizacao}}. Todos os direitos reservados." class="mt-2.5 text-xs leading-[1.3]">
          {t("© {{ano}} · {{nome}} — {{organizacao}}. Todos os direitos reservados.")}
        </p>
        <nav aria-label="Documentos do evento" class="mt-1.5 flex flex-wrap gap-x-4 text-xs leading-[1.3]">
          <a data-link="politica" href={url("/politica-de-privacidade")} class="hover:text-verde-cta">Política de Privacidade</a>
          <a data-link="termos" hidden href="#" class="hover:text-verde-cta">Termos e Condições</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

<script>
  import { esc } from "../lib/api";
  import { aplicarConteudo, extrasTexto, obterConteudo } from "../lib/conteudo";
  import { preencherForma } from "../lib/forma-participacao";
  import { todosProntos } from "../lib/paginas/comum";
  import { aplicarSessaoNoCabecalho } from "../lib/sessao-cabecalho";

  const menu = document.getElementById("menu-mobile")!;
  const abrir = document.querySelector<HTMLButtonElement>("[data-abrir-menu]")!;
  const alternar = (aberto: boolean) => {
    menu.hidden = !aberto;
    abrir.setAttribute("aria-expanded", String(aberto));
    document.body.style.overflow = aberto ? "hidden" : "";
  };
  abrir.addEventListener("click", () => alternar(true));
  menu.querySelector("[data-fechar-menu]")!.addEventListener("click", () => alternar(false));

  aplicarSessaoNoCabecalho();

  preencherForma();

  // Conteúdo editável: aplica paleta, textos, ícones e links; espera as páginas desenharem suas listas e libera a tela.
  obterConteudo()
    .then(async (c) => {
      aplicarConteudo(c, await extrasTexto());
      const real = document.querySelector("[data-realizacao]");
      if (real) real.innerHTML = c.evento.realizacao.map((o) => `<p class="mt-0.5 text-[13px] leading-[1.3]">${esc(o)}</p>`).join("");
      await todosProntos();
    })
    .finally(() => document.documentElement.classList.remove("aguardando"));
</script>
